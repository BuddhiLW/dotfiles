# Allow-list: everything is ignored unless re-included below.
# Rule of thumb: only what `bash main.sh` needs to build the rice.

/*

# --- repo + bootstrap -------------------------------------------------------
!/.gitignore
!/.gitmodules
!/README.org
!/main.sh
!/scripts/
/scripts/**/*.ttf*
/scripts/**/*.deb

# --- shell / X / editors ------------------------------------------------------
!/.bashrc
!/.bash_profile
!/.profile
!/.Xresources
!/.globalrc
!/.wgetrc
!/.nvidia-settings-rc
!/.emacs-profiles.el
!/.doom.d/
!/doom/
!/.vim/
!/vim/

# --- own projects / notes kept in this repo -----------------------------------
!/arara.yaml
!/blw/
/blw/**/st
!/guix/
!/low-level/
!/pomo/
!/progprinciples/
!/chanelio/
!/deps/
!/shiny-enigma/

# --- cluster: public manifests only (secrets are ignored further down) --------
!/talos/

# --- submodules (source only; build output stays ignored) ---------------------
!/gitthings/
/gitthings/*
!/gitthings/ble.sh
!/gitthings/st

# --- ~/.config: rice only ------------------------------------------------------
!/.config/
/.config/*
!/.config/xmonad/
!/.config/xmobar/
!/.config/picom/
!/.config/dunst/
!/.config/rofi/
!/.config/eww/
!/.config/tint2/
!/.config/alacritty.toml
!/.config/kitty/
!/.config/tmux/
!/.config/wal/
!/.config/lazywal/
!/.config/lf/
!/.config/yazi/
!/.config/X11/
!/.config/fonts/
!/.config/shell/
!/.config/git/
!/.config/vim/
!/.config/coc/
!/.config/neofetch/
!/.config/display-scale.env
!/.config/user-dirs.dirs
!/.config/user-dirs.locale
!/.config/topgrade.toml
!/.config/crow-translate/
!/.config/lynx/
!/.config/gdb/
!/.config/ghc/
# only the units this repo owns; the rest of systemd/user is machine state
!/.config/systemd/
/.config/systemd/*
!/.config/systemd/user/
/.config/systemd/user/*
!/.config/systemd/user/gitea-access-proxy.service

# --- ~/.local: own scripts only (no binaries, no pipx/conda shims) -------------
!/.local/
/.local/*
!/.local/bin/
/.local/bin/*
!/.local/bin/apply-display-scale
!/.local/bin/bwm
!/.local/bin/cmt-dir
!/.local/bin/dmenuselect
!/.local/bin/gshot-copy
!/.local/bin/larbs
!/.local/bin/pomob
!/.local/bin/remaps
!/.local/bin/rob-scripts
!/.local/bin/blw/
/.local/bin/blw/cadence
/.local/bin/blw/lazywal
/.local/bin/blw/mcp-shell
/.local/bin/blw/st
!/.local/bin/setbg
!/.local/bin/uim-start
!/.local/bin/zprint
!/.local/bin/gitea-access-proxy

# --- inside allowed dirs --------------------------------------------------------
.config/xmonad/xmonad
.config/xmonad/xmonad-contrib
.config/xmonad/stack.yaml
.config/xmonad/stack.yaml.lock
.vim/pack/bundle/start/vim-snippets
build/
.stack-work/
**/Cache/*
__debug*
*.appimage
.aider*
.vscode
CLAUDE.md

# talos/ holds machine secrets (talosconfig, kubeconfig, the generated machine
# configs carrying the cluster token and CA keys), ~1 GiB of etcd snapshots and
# a pile of photos. Ignore all of it, then WHITELIST the secret-free declarative
# pieces, so the cluster's configuration is reviewable in git instead of living
# only as imperative `talosctl patch` invocations that drift out of the repo.
#
# Before whitelisting anything new here, read it for secrets.
# talos/base/tailscale.patch.yaml is deliberately NOT whitelisted: it carries a
# TS_AUTHKEY. Nor are worker.yaml / worker-gpu.yaml / controlplane*.yaml, which
# are generated and contain machine credentials.
talos/*
!talos/base/
talos/base/*
!talos/base/README.md
!talos/base/kubelet-max-pods.patch.yaml
!talos/base/gpu-dri.patch.yaml
!talos/base/nvidia.patch.yaml
!talos/base/etcd-lan-subnets.patch.yaml
!talos/base/worker-nic-fix.patch.yaml
!talos/base/haproxy-lb.patch.yaml
!talos/kubeprism.patch
!talos/install-disk-patch.yaml
!talos/notes.md
!talos/adding-gpu-worker.md
!talos/base/haproxy-lb.cfg
!talos/base/haproxy-lb-healthcheck.sh
!talos/base/systemd/
talos/base/systemd/*
!talos/base/systemd/*.service
!talos/base/systemd/*.timer
!talos/docs/
talos/docs/*
!talos/docs/*.md
talos/docs/*.bak-*

# --- never, even inside allowed dirs (last, so nothing re-includes these) -----
*.log
*.log.gz
*.bak
*.bak-*
*.old
.env
.env.*
*.pem
*.key
*.keys
*.kdbx
*.gpg
*token*
*secret*
*credential*
kubeconfig*
talosconfig*
.claude/
settings.local.json
.password-store/
.authinfo*
*.jar
.netrwhist

# backup tooling: names contain "secret" but the scripts hold none (gitleaks-checked)
!/scripts/backup/secrets-backup
!/scripts/backup/secrets-verify
!/scripts/backup/secrets-restore

# generated at runtime by hive-addon (removed when the addon shuts down)
.vim/pack/hive/start/*/plugin/zz_hive_runtime.vim
# xmonad build output (regenerated by stack/configure)
.config/xmonad/config.status
.config/xmonad/mk/
.config/xmonad/xmonad.errors
.config/xmonad/xmonad-x86_64-linux
