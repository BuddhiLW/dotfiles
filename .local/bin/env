#!/bin/sh
# add binaries to PATH if they aren't added yet
# affix colons on either side of $PATH to simplify matching
case ":${PATH}:" in
    *:"$HOME/.local/share/../bin":*)
        ;;
    *)
        # Prepending path in case a system-installed binary needs to be overridden
        export PATH="$HOME/.local/share/../bin:$PATH"
        ;;
esac

# When EXECUTED rather than sourced, be the POSIX utility whose name this file
# occupies. Without this, `env VAR=x cmd` on a box where ~/.local/bin precedes
# /usr/bin munges PATH, runs nothing, and exits 0 — a silent no-op with a
# success code. Sourcing is unaffected: `$0` is then the sourcing shell, not
# this file. Kanban 20260812141330-3174408e.
case "${0##*/}" in
    env)
        if [ "$#" -gt 0 ]; then
            exec /usr/bin/env "$@"
        fi
        ;;
esac
