#!/usr/bin/python3
"""Local plain-HTTP front for a Gitea that sits behind Cloudflare Access.

tea (and anything else that speaks the Gitea API) cannot attach Cloudflare's
`cf-access-token` header, so it points here instead:

    tea login add --name <login> --url http://127.0.0.1:3081 ...

Every request is forwarded to the real host with the Access JWT that
`cloudflared access login` cached. The JWT is read from cloudflared on demand,
kept in memory until shortly before it expires, and never logged. When the
Access session is gone the proxy answers 511 with the command that renews it,
rather than passing on Cloudflare's HTML login redirect.

Environment:
  GITEA_ACCESS_UPSTREAM  required, e.g. https://gitea.example.com; kept out of this
                         repo, in ~/.config/gitea-access/env (scripts/install/gitea-access)
  GITEA_ACCESS_LISTEN    default 127.0.0.1:3081
"""
import base64
import http.client
import json
import os
import subprocess
import sys
import threading
import time
import urllib.parse
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

UPSTREAM = os.environ.get("GITEA_ACCESS_UPSTREAM", "").rstrip("/")
if not UPSTREAM.startswith(("https://", "http://")):
    sys.exit("gitea-access-proxy: set GITEA_ACCESS_UPSTREAM (see ~/.config/gitea-access/env)")
LISTEN = os.environ.get("GITEA_ACCESS_LISTEN", "127.0.0.1:3081")
CLOUDFLARED = os.environ.get("CLOUDFLARED", "cloudflared")
REFRESH_MARGIN_S = 120

_up = urllib.parse.urlsplit(UPSTREAM)
HOP_BY_HOP = {"connection", "keep-alive", "proxy-authenticate", "proxy-authorization",
              "te", "trailer", "transfer-encoding", "upgrade", "host"}
LOGIN_HINT = f"cloudflared access login {UPSTREAM}"


class AccessToken:
    """The cached Cloudflare Access JWT for UPSTREAM, refreshed near expiry."""

    def __init__(self):
        self._lock = threading.Lock()
        self._jwt = None
        self._exp = 0.0

    @staticmethod
    def _expiry(jwt):
        try:
            payload = jwt.split(".")[1]
            payload += "=" * (-len(payload) % 4)
            return float(json.loads(base64.urlsafe_b64decode(payload))["exp"])
        except (IndexError, KeyError, ValueError):
            return 0.0

    def get(self):
        with self._lock:
            if self._jwt and time.time() < self._exp - REFRESH_MARGIN_S:
                return self._jwt
            try:
                out = subprocess.run([CLOUDFLARED, "access", "token", f"-app={UPSTREAM}"],
                                     capture_output=True, text=True, timeout=20)
            except (OSError, subprocess.TimeoutExpired):
                return None
            jwt = out.stdout.strip()
            exp = self._expiry(jwt)
            if out.returncode != 0 or not jwt or time.time() >= exp:
                self._jwt, self._exp = None, 0.0
                return None
            self._jwt, self._exp = jwt, exp
            return jwt

    def drop(self):
        with self._lock:
            self._jwt, self._exp = None, 0.0


TOKEN = AccessToken()


def is_access_login(status, headers):
    """True when Cloudflare Access, not Gitea, answered: a redirect to its login."""
    loc = headers.get("location", "")
    return status in (301, 302, 303, 307) and "cloudflareaccess.com" in loc


class Proxy(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    server_version = "gitea-access-proxy"

    def log_message(self, fmt, *args):  # method + path + status only, never headers
        sys.stderr.write("%s %s\n" % (self.log_date_time_string(), fmt % args))

    def _refuse(self, status, message):
        body = (json.dumps({"message": message}) + "\n").encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _forward(self, jwt):
        length = int(self.headers.get("Content-Length") or 0)
        body = self.rfile.read(length) if length else None
        headers = {k: v for k, v in self.headers.items() if k.lower() not in HOP_BY_HOP}
        headers["Host"] = _up.netloc
        headers["cf-access-token"] = jwt
        conn_cls = http.client.HTTPSConnection if _up.scheme == "https" else http.client.HTTPConnection
        conn = conn_cls(_up.netloc, timeout=120)
        conn.request(self.command, self.path, body=body, headers=headers)
        return conn, conn.getresponse()

    def _relay(self):
        jwt = TOKEN.get()
        if not jwt:
            return self._refuse(511, f"Cloudflare Access session missing or expired. Run: {LOGIN_HINT}")
        conn, resp = self._forward(jwt)
        if is_access_login(resp.status, resp.headers):
            conn.close()
            TOKEN.drop()
            return self._refuse(511, f"Cloudflare Access rejected the cached session. Run: {LOGIN_HINT}")
        try:
            self.send_response(resp.status, resp.reason)
            chunked = self.command != "HEAD" and resp.getheader("Content-Length") is None
            for k, v in resp.getheaders():
                if k.lower() in HOP_BY_HOP:
                    continue
                if k.lower() == "location" and v.startswith(UPSTREAM):
                    v = f"http://{LISTEN}{v[len(UPSTREAM):]}"
                self.send_header(k, v)
            if chunked:
                self.send_header("Transfer-Encoding", "chunked")
            self.end_headers()
            while True:
                chunk = resp.read(65536)
                if not chunk:
                    break
                if chunked:
                    self.wfile.write(b"%x\r\n%s\r\n" % (len(chunk), chunk))
                else:
                    self.wfile.write(chunk)
            if chunked:
                self.wfile.write(b"0\r\n\r\n")
        finally:
            conn.close()

    def _handle(self):
        try:
            self._relay()
        except (OSError, http.client.HTTPException) as e:
            try:
                self._refuse(502, f"upstream {UPSTREAM} unreachable: {e.__class__.__name__}")
            except OSError:
                pass

    do_GET = do_POST = do_PUT = do_PATCH = do_DELETE = do_HEAD = do_OPTIONS = _handle


def main():
    host, port = LISTEN.rsplit(":", 1)
    server = ThreadingHTTPServer((host, int(port)), Proxy)
    server.daemon_threads = True
    sys.stderr.write(f"gitea-access-proxy: http://{LISTEN} -> {UPSTREAM}\n")
    server.serve_forever()


if __name__ == "__main__":
    main()
