#!/usr/bin/env python3

"""
This script generates and plays audio for a given text in a specified language
using the Zonos TTS model. It caches the generated audio to avoid redundant
processing on subsequent runs.
"""

import sys
import os
import torch
import torchaudio
import subprocess
from zonos.model import Zonos
from zonos.conditioning import make_cond_dict
from zonos.utils import DEFAULT_DEVICE as device

def main():
    """
    Main function to handle text-to-speech generation and playback.
    """
    if len(sys.argv) != 3:
        print("Usage: zono_tts.py <language-code> <text>")
        sys.exit(1)

    language = sys.argv[1]
    text = sys.argv[2]

    # Define cache path
    cache_filename = f"/tmp/{language}_{text}.wav"

    if os.path.exists(cache_filename):
        print("Playing cached audio...")
        subprocess.Popen(
            ["aplay", cache_filename],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL
        )
        sys.exit(0)

    print("Generating new audio...")

    # Load model
    model = Zonos.from_pretrained("Zyphra/Zonos-v0.1-transformer", device=device)

    # Load reference speaker embedding
    wav, sampling_rate = torchaudio.load("assets/exampleaudio.mp3")  # Replace with your audio file
    speaker = model.make_speaker_embedding(wav, sampling_rate)

    # Prepare conditioning
    torch.manual_seed(421)
    cond_dict = make_cond_dict(text=text, speaker=speaker, language=language)
    conditioning = model.prepare_conditioning(cond_dict)

    # Generate speech
    codes = model.generate(conditioning)
    wavs = model.autoencoder.decode(codes).cpu()

    # Save audio
    torchaudio.save(cache_filename, wavs[0], model.autoencoder.sampling_rate)

    # Play audio
    subprocess.Popen(
        ["aplay", cache_filename],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL
    )

if __name__ == "__main__":
    main()

