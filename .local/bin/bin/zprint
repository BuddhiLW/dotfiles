#!/usr/bin/env bb

; :bbin/start
;
; {:coords
;  {:git/url "https://github.com/kkinnear/zprint.git",
;   :git/tag "1.3.0",
;   :git/sha "118d10b10df0b061d94c02cf1881a399b3cbc6c0"},
;  :lib io.github.kkinnear/zprint}
;
; :bbin/end

(require '[babashka.process :as process]
         '[babashka.fs :as fs]
         '[clojure.string :as str])

(def script-root "/home/khawarizmi/.gitlibs/libs/io.github.kkinnear/zprint/118d10b10df0b061d94c02cf1881a399b3cbc6c0")
(def script-lib 'io.github.kkinnear/zprint)
(def script-coords {:git/url "https://github.com/kkinnear/zprint.git", :git/tag "1.3.0", :git/sha "118d10b10df0b061d94c02cf1881a399b3cbc6c0"})
(def script-main-opts-first "-m")
(def script-main-opts-second "zprint.main")

(def tmp-edn
  (doto (fs/file (fs/temp-dir) (str (gensym "bbin")))
    (spit (str "{:deps {" script-lib script-coords "}}"))
    (fs/delete-on-exit)))

(def base-command
  ["bb" "--deps-root" script-root "--config" (str tmp-edn)
        script-main-opts-first script-main-opts-second
        "--"])

(process/exec (into base-command *command-line-args*))