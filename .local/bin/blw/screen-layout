#!/bin/sh
# Lay out whatever is plugged in: the internal panel (eDP*/LVDS*) first and
# primary, every other connected output to its right at its preferred mode,
# everything disconnected off. Run by xmonad at startup and on M-S-r, so a
# second screen gets its own xmobar without arandr.

outputs=$(xrandr --query)
connected=$(echo "$outputs" | awk '$2 == "connected" {print $1}')
internal=$(echo "$connected" | grep -m1 -E '^(eDP|LVDS)')
# No internal panel (lid closed / desktop): the first connected output leads.
[ -n "$internal" ] || internal=$(echo "$connected" | head -n1)
[ -n "$internal" ] || exit 0

set -- --output "$internal" --primary --auto --pos 0x0 --rotate normal
prev=$internal
for o in $connected; do
  [ "$o" = "$internal" ] && continue
  set -- "$@" --output "$o" --auto --right-of "$prev" --rotate normal
  prev=$o
done
for o in $(echo "$outputs" | awk '$2 == "disconnected" {print $1}'); do
  set -- "$@" --output "$o" --off
done

xrandr "$@"
