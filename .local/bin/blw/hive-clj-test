#!/usr/bin/env bash
# hive-clj-test — stub-clojure regression test for hive-clj exit codes.
#
# Puts a stub `clojure` first on PATH so no real JVM is ever started (matters
# when swap is exhausted on the box). Covers:
#   a. impossible headroom (HIVE_CLJ_MARGIN_MB=99999999)            -> 70
#   b. stub exits 3 with an OOM line                                -> 3
#   c. stub prints "Ran 0 tests containing 0 assertions." exits 0   -> non-zero (78)
#   d. stub prints "Ran 5 tests ... 0 failures, 0 errors." exits 0  -> 0
#   e. stub prints no summary line at all, exits 0                  -> 0
#   f. stub writes to both stdout and stderr; stderr must not leak
#      into the captured stdout stream
#   g. SIGTERM to the wrapper must reach and kill the stub child
#      (the pipeline/job the wrapper launched)
#
# Case c is expected to FAIL against the pre-fix script (it currently
# returns 0 — predates this test file). Cases e, f, g are expected to FAIL
# against the pre-fix script: e exits 1 under `set -euo pipefail` when the
# grep for a summary line finds nothing (pipefail), f leaks stub stderr into
# the captured stdout because of `2>&1 | tee`, and g leaves the stub child
# alive because `clojure ... | tee` is a foreground pipeline with no signal
# forwarding to the clojure side specifically (SIGTERM only hits the already-
# backgrounded case correctly once we background + trap + forward).
#
# All test artifacts (child logs, stub binaries) live under a single mktemp
# dir for this test run and are removed on exit — nothing is left in /tmp.

set -uo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HIVE_CLJ="${HIVE_CLJ_UNDER_TEST:-$here/hive-clj}"

test_tmp=$(mktemp -d)
stub_dir=""
cleanup() { rm -rf "$test_tmp"; [ -n "$stub_dir" ] && rm -rf "$stub_dir"; }
trap cleanup EXIT

make_stub() {
  # make_stub <exit-code> <stdout-line...>
  local code="$1"; shift
  stub_dir=$(mktemp -d)
  cat > "$stub_dir/clojure" <<EOF
#!/usr/bin/env bash
$(for line in "$@"; do printf 'echo %q\n' "$line"; done)
exit $code
EOF
  chmod +x "$stub_dir/clojure"
}

pass=0
fail=0

check() {
  local name="$1" expected="$2" actual="$3"
  if [ "$actual" = "$expected" ]; then
    echo "PASS: $name (exit $actual)"
    pass=$((pass + 1))
  else
    echo "FAIL: $name — expected exit $expected, got $actual"
    fail=$((fail + 1))
  fi
}

run_with_stub() {
  PATH="$stub_dir:$PATH" "$HIVE_CLJ" "$@"
}

# a. impossible headroom -> 70
make_stub 0 "should never run"
HIVE_CLJ_MARGIN_MB=99999999 run_with_stub -J-Xmx256m -M:test >"$test_tmp/a.log" 2>&1
rc=$?
check "refusal on impossible headroom" 70 "$rc"
rm -rf "$stub_dir"

# b. OOM stub exits 3
make_stub 3 "Terminating due to java.lang.OutOfMemoryError"
run_with_stub -J-Xmx256m -M:test >"$test_tmp/b.log" 2>&1
rc=$?
check "OOM stub exit passthrough" 3 "$rc"
rm -rf "$stub_dir"

# c. zero tests, exit 0 from child -> must become non-zero (78)
make_stub 0 "Ran 0 tests containing 0 assertions."
run_with_stub -J-Xmx256m -M:test >"$test_tmp/c.log" 2>&1
rc=$?
check "zero-test run refused" 78 "$rc"
rm -rf "$stub_dir"

# d. real test pass -> 0
make_stub 0 "Ran 5 tests containing 9 assertions. 0 failures, 0 errors."
run_with_stub -J-Xmx256m -M:test >"$test_tmp/d.log" 2>&1
rc=$?
check "non-vacuous passing run stays 0" 0 "$rc"
rm -rf "$stub_dir"

# e. no summary line at all (plain script / -X run), exit 0 -> stays 0
make_stub 0 "just some output" "no test summary here"
run_with_stub -J-Xmx256m -M:test >"$test_tmp/e.log" 2>&1
rc=$?
check "no-summary run stays 0" 0 "$rc"
rm -rf "$stub_dir"

# f. stderr must stay out of the captured stdout stream
stub_dir=$(mktemp -d)
cat > "$stub_dir/clojure" <<'EOF'
#!/usr/bin/env bash
echo "stub-on-stdout"
echo "stub-on-stderr" >&2
exit 0
EOF
chmod +x "$stub_dir/clojure"
PATH="$stub_dir:$PATH" "$HIVE_CLJ" -J-Xmx256m -M:test >"$test_tmp/f.out" 2>"$test_tmp/f.err"
rc=$?
if grep -q "stub-on-stderr" "$test_tmp/f.out"; then
  echo "FAIL: stderr leaked into stdout"
  fail=$((fail + 1))
else
  echo "PASS: stderr did not leak into stdout"
  pass=$((pass + 1))
fi
if ! grep -q "stub-on-stderr" "$test_tmp/f.err"; then
  echo "FAIL: stderr line missing from stderr capture entirely"
  fail=$((fail + 1))
else
  echo "PASS: stderr line present on stderr"
  pass=$((pass + 1))
fi
rm -rf "$stub_dir"

# g. SIGTERM to the wrapper must reach the stub child
stub_dir=$(mktemp -d)
marker="$test_tmp/g-child-pid"
cat > "$stub_dir/clojure" <<EOF
#!/usr/bin/env bash
echo \$\$ > "$marker"
sleep 20
EOF
chmod +x "$stub_dir/clojure"
PATH="$stub_dir:$PATH" "$HIVE_CLJ" -J-Xmx256m -M:test >"$test_tmp/g.log" 2>&1 &
wrapper_pid=$!
# wait for the stub child to report its own pid
for _ in $(seq 1 50); do
  [ -s "$marker" ] && break
  sleep 0.1
done
child_pid=$(cat "$marker" 2>/dev/null || true)
kill -TERM "$wrapper_pid" 2>/dev/null || true
# give the wrapper time to forward the signal and exit
for _ in $(seq 1 30); do
  kill -0 "$wrapper_pid" 2>/dev/null || break
  sleep 0.1
done
sleep 0.3
if [ -n "$child_pid" ] && kill -0 "$child_pid" 2>/dev/null; then
  echo "FAIL: SIGTERM to wrapper did not reach stub child (pid $child_pid still alive)"
  fail=$((fail + 1))
  kill -KILL "$child_pid" 2>/dev/null || true
else
  echo "PASS: SIGTERM to wrapper killed the stub child"
  pass=$((pass + 1))
fi
rm -rf "$stub_dir"

echo "---"
echo "pass=$pass fail=$fail"
[ "$fail" -eq 0 ]
