#!/usr/bin/bash
# performance <low|balanced|high> - set CPU power profile
# no arg or "status" - show current state

set -euo pipefail

show() {
    printf 'profile : %s\n' "$(powerprofilesctl get)"
    printf 'firmware: %s\n' "$(cat /sys/firmware/acpi/platform_profile 2>/dev/null || echo n/a)"
    printf 'epp     : %s\n' "$(cat /sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference 2>/dev/null || echo n/a)"
    printf 'pkg temp: %s C\n' "$(( $(cat /sys/class/hwmon/hwmon6/temp1_input 2>/dev/null || echo 0) / 1000 ))"
    printf 'fans    : %s / %s rpm\n' \
        "$(cat /sys/class/hwmon/hwmon6/fan1_input 2>/dev/null || echo '?')" \
        "$(cat /sys/class/hwmon/hwmon6/fan2_input 2>/dev/null || echo '?')"
}

case "${1:-status}" in
    low|quiet|powersave|power-saver) target=power-saver ;;
    balanced|mid|balance)            target=balanced ;;
    high|perf|performance|max)       target=performance ;;
    status|"")                       show; exit 0 ;;
    -h|--help|help)
        echo "usage: performance [low|balanced|high|status]"
        exit 0 ;;
    *)
        echo "performance: unknown mode '$1' (want low|balanced|high|status)" >&2
        exit 1 ;;
esac

powerprofilesctl set "$target"
show
