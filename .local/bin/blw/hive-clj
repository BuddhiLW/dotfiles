#!/usr/bin/env bash
# hive-clj — launch `clojure` only when this box has headroom for the heap asked for.
#
# Per-process -Xmx is necessary and NOT sufficient: the unbounded quantity is the
# SUM of concurrent JVMs beside the resident coordinator, and nothing in the
# toolchain observes it. Four coordinator OOM-kills are on record. See kanban
# 20260829135646-572da364 and hive memory 20260824155312-0efb1b64.
#
# Usage:  hive-clj -J-Xmx2g -M:test -n some.ns
#         hive-clj -M:test:no-runner script.clj
#
# Env:
#   HIVE_CLJ_MARGIN_MB   headroom required beyond -Xmx (default 1536)
#   HIVE_CLJ_DEFAULT_MB  heap injected when the caller names none (default 2048)
#   HIVE_CLJ_FORCE=1     report and launch anyway
#
#   HIVE_CLJ_VACUOUS_EXIT  exit code for a zero-test run (default 78)
#
# Exit codes:
#   70  refused to launch: not enough headroom (HIVE_CLJ_FORCE=1 overrides)
#   78  the clojure.test runner reported "Ran 0 tests": a vacuous pass is
#       not a pass; a script/-X invocation with no test-summary line is
#       untouched and keeps the child's own exit code
#   *   otherwise the child process's own exit status, unchanged
#
# The zero-test check matches only the clojure.test/cognitect-runner summary
# line ("Ran N tests containing M assertions."). A kaocha summary ("N tests,
# M assertions, 0 failures") is not recognised and is always treated as a
# non-test (untouched) run.
#
# stdout and stderr are kept separate throughout: the child's stdout is
# teed to a log and to our own stdout, its stderr is teed to a second log
# and to our own stderr. A caller piping/redirecting one stream never sees
# the other folded in.
#
# The child runs as a background job so a signal to this wrapper's PID can
# be forwarded to it before we wait; TERM/INT/HUP all forward, so killing
# the wrapper (not just Ctrl-C to the whole foreground process group) also
# kills the JVM instead of orphaning it under PID 1.

set -euo pipefail

MARGIN_MB="${HIVE_CLJ_MARGIN_MB:-1536}"
DEFAULT_MB="${HIVE_CLJ_DEFAULT_MB:-2048}"

meminfo_mb() { awk -v k="$1:" '$1 == k {print int($2/1024)}' /proc/meminfo; }

avail_mb=$(meminfo_mb MemAvailable)
swap_total=$(meminfo_mb SwapTotal)
swap_free=$(meminfo_mb SwapFree)

# -Xmx as megabytes, from the first -J-Xmx the caller passed.
xmx_mb=""
for arg in "$@"; do
  case "$arg" in
    -J-Xmx*)
      spec="${arg#-J-Xmx}"
      num="${spec%[gGmMkK]}"
      case "$spec" in
        *[gG]) xmx_mb=$(( num * 1024 )) ;;
        *[mM]) xmx_mb=$num ;;
        *[kK]) xmx_mb=$(( num / 1024 )) ;;
        *)     xmx_mb=$(( num / 1048576 )) ;;
      esac
      break
      ;;
  esac
done

args=("$@")
if [ -z "$xmx_mb" ]; then
  # An unbounded heap is the case that actually killed the coordinator: the
  # hive-shape suite reached 6.8 GB with no -Xmx. Never launch one silently.
  xmx_mb="$DEFAULT_MB"
  args=("-J-Xmx${DEFAULT_MB}m" "$@")
  echo "hive-clj: no -J-Xmx given; injecting -J-Xmx${DEFAULT_MB}m" >&2
fi

need_mb=$(( xmx_mb + MARGIN_MB ))

resident_jvms() {
  ps -eo rss,etime,args --sort=-rss \
    | awk 'NR>1 && $0 ~ /java/ && $0 !~ /awk/ {printf "    %6.1f GB  %-12s %.70s\n", $1/1048576, $2, $3}' \
    | head -6
}

if [ "$avail_mb" -lt "$need_mb" ]; then
  {
    echo "hive-clj: REFUSING to launch — not enough headroom."
    echo "    heap asked for : ${xmx_mb} MB"
    echo "    margin         : ${MARGIN_MB} MB"
    echo "    required       : ${need_mb} MB"
    echo "    available      : ${avail_mb} MB"
    echo "  JVMs already resident:"
    resident_jvms
    echo "  Wait for one to exit, lower -J-Xmx, or set HIVE_CLJ_FORCE=1 to override."
  } >&2
  [ "${HIVE_CLJ_FORCE:-}" = "1" ] || exit 70
  echo "hive-clj: HIVE_CLJ_FORCE=1 — launching anyway" >&2
fi

# Swap exhaustion does not fail the headroom test but is the condition under
# which a bounded JVM still thrashes and its neighbours still get killed.
if [ "$swap_total" -gt 0 ] && [ "$swap_free" -lt 256 ]; then
  echo "hive-clj: WARNING — swap is exhausted (${swap_free}/${swap_total} MB free);" \
       "expect thrashing and be ready to kill this run." >&2
fi

vacuous_exit="${HIVE_CLJ_VACUOUS_EXIT:-78}"

log_dir=$(mktemp -d)
trap 'rm -rf "$log_dir"' EXIT
out_log="$log_dir/stdout.log"
err_log="$log_dir/stderr.log"
out_fifo="$log_dir/stdout.fifo"
err_fifo="$log_dir/stderr.fifo"
mkfifo "$out_fifo" "$err_fifo"

# Each stream gets its own tee, reading from its own fifo, so stdout and
# stderr never mix. The child runs as a background job so a signal to
# THIS process can be forwarded to it before we wait on it; we then also
# wait on the two tee jobs so the log files are fully flushed before we
# grep them below (wait on the child alone races the tee's own write).
tee "$out_log" < "$out_fifo" &
tee_out=$!
tee "$err_log" < "$err_fifo" >&2 &
tee_err=$!

clojure "${args[@]}" > "$out_fifo" 2> "$err_fifo" &
child=$!

forward() {
  kill -TERM "$child" 2>/dev/null || true
}
trap forward TERM INT HUP

set +e
wait "$child"
rc=$?
wait "$tee_out" "$tee_err"
set -e

trap - TERM INT HUP

if [ "$rc" -ne 0 ]; then
  exit "$rc"
fi

# A clojure.test summary line with zero tests ran is a vacuous pass, not a
# pass. A log with no summary line at all is a non-test invocation (plain
# script, -X, a REPL) and stays untouched at rc 0: `|| true` keeps a grep
# miss (rc 1) from tripping `set -e` under pipefail.
summary=$(grep -E '^Ran [0-9]+ tests? containing [0-9]+ assertions?\.' "$out_log" | tail -1 || true)
if [ -n "$summary" ]; then
  tests=$(printf '%s\n' "$summary" | sed -E 's/^Ran ([0-9]+) tests?.*/\1/')
  if [ "${tests:-0}" -eq 0 ]; then
    echo "hive-clj: zero tests ran, refusing to report success" >&2
    exit "$vacuous_exit"
  fi
fi

exit 0
