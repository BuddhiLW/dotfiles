#!/usr/bin/env bash

set -Eeuo pipefail
dry=0
[[ "${1:-}" == "-n" ]] && { dry=1; shift; }

pattern="$1"; shift || true
args=$(printf '! -name %q ' "$@")

if ((dry)); then
  find . -maxdepth 1 -type f -regextype posix-extended -regex ".*/${pattern}" $args -print
else
  find . -maxdepth 1 -type f -regextype posix-extended -regex ".*/${pattern}" $args -delete
fi
