#!/bin/bash

WIDTHS=(480 720 1080)
FORMATS=("avif" "webp")
ROOT_DIR="."
OUT_DIR="./optimized/parcerias"
DRY_RUN=false

# Argumento --dry-run
if [[ "$1" == "--dry-run" ]]; then
  DRY_RUN=true
  echo "🟡 Modo simulação (dry-run): Nenhum arquivo será criado."
fi

mkdir -p "$OUT_DIR"

command -v convert >/dev/null || { echo "❌ Requer ImageMagick (convert)"; exit 1; }
command -v cwebp >/dev/null || { echo "❌ Requer cwebp"; exit 1; }
command -v avifenc >/dev/null || { echo "❌ Requer avifenc"; exit 1; }

sanitize() {
  echo "$1" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/_/g'
}

find "$ROOT_DIR" -mindepth 2 -type f \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" \) | sort | while read -r file; do
  dir_name=$(basename "$(dirname "$file")")
  clean_dir=$(sanitize "$dir_name")

  count_var="count_$clean_dir"
  eval current_index=\${$count_var:-1}
  eval $count_var=$((current_index + 1))
  index=$((current_index))

  # Original
  for format in "${FORMATS[@]}"; do
    out_file="$OUT_DIR/${clean_dir}_${index}_original.${format}"
    if $DRY_RUN; then
      echo "🔸 [dry-run] Criaria: $out_file"
    else
      if [[ "$format" == "webp" ]]; then
        cwebp -quiet -q 100 "$file" -o "$out_file"
      elif [[ "$format" == "avif" ]]; then
        avifenc -q 100 "$file" "$out_file" >/dev/null
      fi
      echo "✅ $out_file"
    fi
  done

  # Redimensionadas
  for width in "${WIDTHS[@]}"; do
    tmp_file="/tmp/${clean_dir}_${index}_${width}.png"
    if ! $DRY_RUN; then
      convert "$file" -resize "${width}" "$tmp_file"
    fi

    for format in "${FORMATS[@]}"; do
      out_file="$OUT_DIR/${clean_dir}_${index}_${width}.${format}"
      if $DRY_RUN; then
        echo "🔸 [dry-run] Criaria: $out_file"
      else
        if [[ "$format" == "webp" ]]; then
          cwebp -quiet -q 100 "$tmp_file" -o "$out_file"
        elif [[ "$format" == "avif" ]]; then
          avifenc -q 100 "$tmp_file" "$out_file" >/dev/null
        fi
        echo "✅ $out_file"
      fi
    done

    if ! $DRY_RUN; then
      rm "$tmp_file"
    fi
  done
done

