#!/usr/bin/bash

cd $HOME/PP/hive/hive-mcp/

# --- Milvus via Tailscale subnet router (tag:hive, ACL-controlled) ---
# Reached via the k8s ClusterIP over the hive-subnet-router tailnet peer
# advertising 10.96.0.0/12 (see k8s-agi/base/tailscale-operator/subnet-router.yaml).
# The ClusterIP is pinned in contexts/home-lab/milvus/service.yaml so it
# is stable across redeploys.
#
# MILVUS_HOSTS is a space-separated fallback list tried in order. The
# wait_for_milvus loop below picks the first reachable one and exports
# it as MILVUS_HOST. Internal retry (3 attempts, 2 s backoff) lives in
# hive-milvus/store.clj; this loop only gates the nREPL start so we
# don't launch into a dead endpoint.
MILVUS_HOSTS="${MILVUS_HOSTS:-10.104.172.142}"
export MILVUS_PORT=19530
export MILVUS_TRANSPORT="${MILVUS_TRANSPORT:-http}"
MILVUS_WAIT_TIMEOUT="${MILVUS_WAIT_TIMEOUT:-120}"  # seconds total budget
TAILSCALE_WAIT_TIMEOUT="${TAILSCALE_WAIT_TIMEOUT:-30}"  # seconds total budget

# Tailscale subnet routing is handled by vpn-kis ip-rule priority 5058
# (`ip rule add to 10.96.0.0/12 lookup 52`), which fires BEFORE Mullvad's
# fwmark rule at 5210. RFC1918 traffic to tailnet-advertised CIDRs exits
# tailscale0, not the Mullvad tunnel. No process-level split-tunnel needed.
# All clearnet (LLM APIs, etc.) stays inside the Mullvad tunnel — no leak.
# Verify with: ip route get 10.104.172.142    (must show 'dev tailscale0')
# If the priority-5058 rules are missing, re-run vpn-kis with tailscale in
# the providers list to install /etc/systemd/system/vpn-killswitch-tailscale-routes.service.
EXCLUDE=""

# Pre-flight: ensure tailscaled is Running AND the hive subnet route
# (10.96.0.0/12 advertised by hive-subnet-router) is installed in the
# routing table. Without this, fresh boots race against tailscaled
# coming up and the Milvus ClusterIP is unreachable on first try.
#
# Self-heals via sudo: starts tailscaled if inactive, runs
# `tailscale up --accept-routes` if BackendState != Running OR the
# subnet route is missing. Requires NOPASSWD sudo for systemctl/tailscale
# or an interactive terminal for the password prompt.
milvus_reachable() {
  local host
  for host in $MILVUS_HOSTS; do
    if timeout 2 $EXCLUDE bash -c "</dev/tcp/$host/$MILVUS_PORT" 2>/dev/null; then
      return 0
    fi
  done
  return 1
}

tailscale_ready() {
  tailscale status --peers=false --json 2>/dev/null \
    | grep -q '"BackendState":"Running"' \
    && ip route show 2>/dev/null | grep -q '10\.96\.0\.0/12'
}

wait_for_tailscale() {
  # Short-circuit: if Milvus is already reachable (tailscale, Eddie VPN,
  # or any other route), skip the tailscale preflight and its sudo prompts.
  # The subnet-route check is only load-bearing when Milvus itself is unreachable.
  if milvus_reachable; then
    echo "hive-mcp: Milvus already reachable — skipping tailscale preflight"
    return 0
  fi

  if tailscale_ready; then
    echo "hive-mcp: tailscale already ready"
    return 0
  fi

  if ! systemctl is-active --quiet tailscaled; then
    echo "hive-mcp: tailscaled inactive — starting via sudo"
    sudo systemctl start tailscaled
  fi

  if ! tailscale_ready; then
    echo "hive-mcp: bringing tailscale up with --accept-routes via sudo"
    sudo tailscale up --accept-routes --accept-dns=false
  fi

  local start=$SECONDS
  while (( SECONDS - start < TAILSCALE_WAIT_TIMEOUT )); do
    if tailscale_ready || milvus_reachable; then
      echo "hive-mcp: tailscale/Milvus ready (${SECONDS}s in)"
      return 0
    fi
    sleep 1
  done
  echo "hive-mcp: WARNING tailscale not ready after ${TAILSCALE_WAIT_TIMEOUT}s — Milvus probe will likely fail" >&2
  return 1
}
wait_for_tailscale

# Pre-flight: wait until Milvus is reachable on at least one host in
# MILVUS_HOSTS (space-separated, in priority order), using exponential
# backoff with a cap. Starts fast (first try after 1 s), doubles up to
# 30 s between attempts, gives up after MILVUS_WAIT_TIMEOUT seconds.
# On total failure we still start nREPL — hive-milvus/store.clj has its
# own background healing loop (start-reconnect-loop!) that takes over.
wait_for_milvus() {
  local start=$SECONDS
  local delay=1
  local attempt=1
  while (( SECONDS - start < MILVUS_WAIT_TIMEOUT )); do
    for host in $MILVUS_HOSTS; do
      if timeout 3 $EXCLUDE bash -c "</dev/tcp/$host/$MILVUS_PORT" 2>/dev/null; then
        export MILVUS_HOST="$host"
        echo "hive-mcp: Milvus reachable at $host:$MILVUS_PORT (attempt $attempt, ${SECONDS}s in)"
        return 0
      fi
    done
    echo "hive-mcp: Milvus unreachable on [$MILVUS_HOSTS] (attempt $attempt), retrying in ${delay}s" >&2
    sleep "$delay"
    attempt=$(( attempt + 1 ))
    delay=$(( delay * 2 ))
    (( delay > 30 )) && delay=30
  done
  export MILVUS_HOST="${MILVUS_HOST:-${MILVUS_HOSTS%% *}}"
  echo "hive-mcp: WARNING no Milvus host in [$MILVUS_HOSTS] reachable after ${MILVUS_WAIT_TIMEOUT}s; starting with $MILVUS_HOST anyway (background healing loop will take over)" >&2
  return 1
}
wait_for_milvus

export MILVUS_USER=root
export MILVUS_PASSWORD="$(pass show milvus/root-password)"
export MILVUS_TOKEN="root:$(pass show milvus/root-password)"
# HTTP transport: ~14% faster p50 on get-entry, tighter tails on query-entries,
# avoids gVisor idle-flow pruning class entirely (REST is stateless).
# Benchmark 2026-04-17: HTTP beat gRPC p50 on 3/4 ops (get/query/search).
export MILVUS_TRANSPORT=http

# --- Ollama via Cloudflare tunnel (Tailscale exposure pending) ---
if ! bash -c 'echo >/dev/tcp/localhost/11434' 2>/dev/null; then
  cloudflared access tcp --hostname ollama.hive-mcp.com --url localhost:11434 &
  BG_PIDS="$BG_PIDS $!"
fi

if [ -n "$BG_PIDS" ]; then
  trap "kill $BG_PIDS 2>/dev/null" EXIT
  sleep 1
fi

export OLLAMA_HOST=http://localhost:11434

# --- ENGINE-L0.5 — bounded manifold wait-pool (OOM cascade defense) ---
# Cap the JVM-wide manifold.executor/wait-pool so a retry storm can't grow
# it without bound. Without this, the dirigiste-backed pool defaults to
# Integer/MAX_VALUE and was a contributor to the 2026-05-11 13.5 GB heap
# death. Two override paths (env wins; sys-prop is the fallback for
# tooling that can't set env). Leave both unset to use the app default
# of max(64, 4×CPU).
#
# Operator knobs:
#   HIVE_MANIFOLD_WAIT_POOL_MAX=N       env (this script forwards verbatim)
#   -Dhive.manifold.wait-pool-max=N      sys-prop (passed via JAVA_OPTS below)
#
# BUGFIX 2026-08-07: this block used to export JVM_OPTS, which the Clojure CLI
# DOES NOT READ — the sys-prop half of this defense was silently dead. Verified:
#   JVM_OPTS="-Dhive.probe.canary=yes" clojure -M -e '(System/getProperty "hive.probe.canary")'
#   => nil
# The `clojure` launcher expands $JAVA_OPTS (not $JVM_OPTS) into its final exec.
# The env half (HIVE_MANIFOLD_WAIT_POOL_MAX, read directly by the app) always worked;
# only the documented "sys-prop fallback for tooling that can't set env" was broken.
HIVE_MANIFOLD_WAIT_POOL_MAX="${HIVE_MANIFOLD_WAIT_POOL_MAX:-}"
export HIVE_MANIFOLD_WAIT_POOL_MAX
if [ -n "$HIVE_MANIFOLD_WAIT_POOL_MAX" ]; then
  JAVA_OPTS="${JAVA_OPTS:-} -Dhive.manifold.wait-pool-max=$HIVE_MANIFOLD_WAIT_POOL_MAX"
  echo "hive-mcp: manifold wait-pool capped at $HIVE_MANIFOLD_WAIT_POOL_MAX threads"
fi
export JAVA_OPTS

# --- Heap-leak forensics: JFR OldObjectSample from a COLD boot (HEAP-DOMINATOR) ---
# The coordinator leaks a static ~10 GB set (~70M datalevin datalog tuples + 37M
# datalevin.bits.Retrieved) whose retainer is invisible to every in-process scan,
# and MAT is impossible (the leak re-inflates to ~85% RAM before MAT can load a
# dump). JFR's jdk.OldObjectSample is the MAT-substitute: it samples allocations
# that SURVIVE GC and, at dump with path-to-gc-roots=true, emits each with its
# allocation stack AND its reference chain to a GC root — which names the retainer.
# It only captures allocations made AFTER it starts, so it MUST begin at boot;
# wiring it here (not in the shared deps.edn :dev/:nrepl alias) keeps it on the
# live coordinator only. Event set: hive-mcp/leak.jfc (old-object + throttled
# alloc + GC; minimal overhead). Each boot writes its own timestamped .jfr.
#
# Read the holder once it has re-leaked to several GB:
#   pid=$(pgrep -f hive-mcp.server.core)
#   jcmd "$pid" JFR.dump name=hive-leak path-to-gc-roots=true filename=/tmp/leak.jfr
#   jfr print --events jdk.OldObjectSample /tmp/leak.jfr    # reference chains = the retainer
# Disable for a run:  HIVE_JFR_LEAK=0 hive-mcp
JFR_OPT=""
if [ "${HIVE_JFR_LEAK:-1}" = "1" ]; then
  JFR_FILE="${HIVE_JFR_FILE:-$HOME/hive-leak-$(date +%Y%m%d-%H%M%S).jfr}"
  JFR_OPT="-J-XX:StartFlightRecording=name=hive-leak,settings=$HOME/PP/hive/hive-mcp/leak.jfc,path-to-gc-roots=true,maxsize=300m,maxage=12h,dumponexit=true,filename=$JFR_FILE"
  echo "hive-mcp: JFR leak recording ACTIVE -> $JFR_FILE  (HIVE_JFR_LEAK=0 to disable)"
fi

# --- Async warm-boot: ansatz mathlib REPL (non-blocking, RAM-gated) ---
# (init! "mathlib") takes ~13 min and is OOM-prone; boot it in the BACKGROUND
# so a warm REPL is ready without a blocking mid-session init. nREPL comes up
# immediately on :$ANSATZ_MATHLIB_PORT; the store index build runs in a future.
# Survives the exec below (separate process) and persists across hive-mcp
# restarts (port-reuse guard re-uses a live one, re-boots a dead one).
# Disable: HIVE_ANSATZ_MATHLIB=0. Floor: ANSATZ_MATHLIB_MIN_FREE_MB (default 12 GB).
ANSATZ_MATHLIB_PORT="${ANSATZ_MATHLIB_PORT:-7899}"; export ANSATZ_MATHLIB_PORT
if [ "${HIVE_ANSATZ_MATHLIB:-1}" = "1" ] \
   && [ -d "$HOME/.local/share/ansatz/stores/mathlib" ] \
   && [ -d "$HOME/PP/hive/clones-ref/ansatz/classes" ] \
   && ! ss -tln 2>/dev/null | grep -q ":${ANSATZ_MATHLIB_PORT} "; then
  ansatz_free_mb=$(awk '/MemAvailable/{print int($2/1024)}' /proc/meminfo)
  if (( ansatz_free_mb >= ${ANSATZ_MATHLIB_MIN_FREE_MB:-12000} )); then
    echo "hive-mcp: async-booting ansatz mathlib REPL on :$ANSATZ_MATHLIB_PORT (${ansatz_free_mb}MB free) -> $HOME/ansatz-mathlib-boot.log"
    ( cd "$HOME/PP/hive/clones-ref/ansatz" && exec clj -M:mathlib-nrepl ) \
      >"$HOME/ansatz-mathlib-boot.log" 2>&1 &
    echo "hive-mcp: ansatz mathlib boot pid $!"
  else
    echo "hive-mcp: SKIP ansatz mathlib boot — ${ansatz_free_mb}MB free < ${ANSATZ_MATHLIB_MIN_FREE_MB:-12000}MB floor" >&2
  fi
fi

# --- RSS containment: metaspace cap + soft-ref aging (measured 2026-08-07) ---
# Lives HERE, not in the shared deps.edn :dev/:nrepl alias, for the same reason
# JFR does: those aliases are also used by ephemeral dev REPLs, which neither
# need these caps nor should die from them. Coordinator-only.
# Full profile + reproduction: hive memory 20260807162003-4113279d and
# 20260807164931-62a9b05e.
#
# MaxMetaspaceSize was UNLIMITED while metaspace sat at 512 MB used / 664 MB
# committed across ~100k classes for 2,580 loaded namespaces — nothing bounded it.
# DANGER: deps.edn already sets -XX:+ExitOnOutOfMemoryError, so a Metaspace OOM
# EXITS the coordinator. This cap must keep real headroom over peak; 1g is ~2x the
# observed steady state. Do NOT tighten toward the observed 664 MB without first
# re-measuring under full addon load.
#
# SoftRefLRUPolicyMSPerMB: clojure.lang.DynamicClassLoader.classCache held 100,146
# SoftReferences with ZERO cleared — the default 1000 ms/MB against ~4.9 GB free
# heap means ~80 MINUTES of soft-ref survival, so orphaned eval'd classes never
# aged out. 50 => ~4 min. Reclaims dead code only: classes of LIVE namespaces stay
# strongly reachable through their Vars and are unaffected.
#
# Both are a slow-bleed cap at REST. Under load the gigabytes are elsewhere — G1
# committed-heap ratchet (kanban 20260807164934-17a01dd6) and the datahike datom
# working set (kanban 20260702170120-316f65b2). Do not expect these to fix a spike.
# Disable for a run:  HIVE_MEM_CAPS=0 hive-mcp
MEM_OPTS=""
if [ "${HIVE_MEM_CAPS:-1}" = "1" ]; then
  MEM_OPTS="-J-XX:MaxMetaspaceSize=1g -J-XX:SoftRefLRUPolicyMSPerMB=50"
  echo "hive-mcp: memory caps ACTIVE -> $MEM_OPTS  (HIVE_MEM_CAPS=0 to disable)"
fi

DEPS=$(cat local.deps.edn)
echo " ---- DEPS ---- \n"
echo "$DEPS"

# --- Coordinator-death legibility (kanban TEST-JVM-SUM, 2026-09-03) ---
#
# 21 hard kills in 8 days left NO evidence but a 0-byte JFR, and that is not a
# coincidence: `dumponexit` cannot run when the JVM is SIGKILLed, so the one
# artefact that would say why is exactly the one the OOM killer prevents.
#
# `exec` is what made that unavoidable. It REPLACES this shell with the JVM, so
# nothing survives the JVM to write a line about it. Running the JVM as a CHILD
# and waiting costs one dormant bash process and buys an exit record.
#
# The RSS at the kill cannot be read after the kill: /proc/<pid> is gone by
# then. So a sampler writes the last-known RSS and peak to a file every
# HIVE_DEATHLOG_INTERVAL seconds and the record reports that LAST SAMPLE, which
# is up to one interval stale and is labelled as such. Host MemAvailable and
# the count of other JVMs are read at exit, a moment or two late, and are
# likewise labelled rather than presented as the values at the instant of death.
# That staleness is the point of the card: the unbounded quantity is the SUM of
# concurrent JVMs beside the coordinator, and nothing was observing it at all.
#
# Disable: HIVE_DEATHLOG=0, which restores the plain exec.

# $JFR_OPT is intentionally unquoted: it is a single word (no spaces) when set,
# and expands to nothing when leak recording is disabled.
# $MEM_OPTS is likewise unquoted, but for the opposite reason: it is TWO words and
# must word-split into two separate -J args.

if [ "${HIVE_DEATHLOG:-1}" != "1" ]; then
  exec $EXCLUDE clj $JFR_OPT $MEM_OPTS -Sdeps "$DEPS" -M:dev:nrepl
fi

DEATHLOG="${HIVE_DEATHLOG_FILE:-$HOME/.local/state/hive/coordinator-deaths.log}"
mkdir -p "$(dirname "$DEATHLOG")"
SAMPLE="$(mktemp -t hive-coord-sample.XXXXXX)"
start_epoch=$(date +%s)

$EXCLUDE clj $JFR_OPT $MEM_OPTS -Sdeps "$DEPS" -M:dev:nrepl &
coord_pid=$!

# Forward a stop to the JVM: without `exec` this shell is now the signal
# target, and a coordinator that ignored SIGTERM would be a worse bug than
# the one being fixed.
trap 'kill -TERM "$coord_pid" 2>/dev/null' TERM INT

# `$!` is NOT the JVM. The launch chain is
#
#     this shell  ->  clj  ->  rlwrap  ->  clojure  ->  exec java
#
# so `$coord_pid` is the head of it and sampling that reads rlwrap's ~1 MB
# instead of the coordinator's gigabytes. Measured: against a real JVM growing
# a 1.6 GB heap this reported last_rss_mb=1, which is worse than no number at
# all because it looks like one. Walk down to the java process instead.
#
# Waiting still happens on $coord_pid: rlwrap propagates the JVM's status, and
# that is the process this shell actually owns.
jvm_descendant() {
  local pids="$1" depth=0 next p
  while [ -n "$pids" ] && [ "$depth" -lt 8 ]; do
    next=""
    for p in $pids; do
      if [ "$(cat "/proc/$p/comm" 2>/dev/null)" = "java" ]; then
        printf '%s' "$p"; return 0
      fi
      next="$next $(pgrep -P "$p" 2>/dev/null | tr '\n' ' ')"
    done
    pids="$next"; depth=$((depth + 1))
  done
  return 1
}

(
  jvm=""
  while kill -0 "$coord_pid" 2>/dev/null; do
    # Re-resolve until found: the JVM appears a moment after the wrapper, and
    # a sampler that gave up on the first miss would sample nothing all run.
    [ -z "$jvm" ] || [ ! -r "/proc/$jvm/status" ] && jvm=$(jvm_descendant "$coord_pid")
    if [ -n "$jvm" ] && [ -r "/proc/$jvm/status" ]; then
      avail=$(awk '/MemAvailable/{print int($2/1024)}' /proc/meminfo)
      # VmHWM is the PEAK resident size, which is the number a leak
      # investigation wants and which no post-mortem can recover.
      awk -v avail="$avail" \
          '/^VmRSS:/{rss=int($2/1024)} /^VmHWM:/{hwm=int($2/1024)}
           END{printf "%d %d %d\n", rss, hwm, avail}' \
          "/proc/$jvm/status" >"$SAMPLE.tmp" 2>/dev/null &&
        mv "$SAMPLE.tmp" "$SAMPLE"
    fi
    sleep "${HIVE_DEATHLOG_INTERVAL:-10}"
  done
) &
sampler_pid=$!

wait "$coord_pid"; rc=$?
kill "$sampler_pid" 2>/dev/null
wait "$sampler_pid" 2>/dev/null

last_rss=0; last_hwm=0; last_avail=0
[ -s "$SAMPLE" ] && read -r last_rss last_hwm last_avail <"$SAMPLE"
rm -f "$SAMPLE" "$SAMPLE.tmp"

# 128+n is a SIGNALLED exit, and 137 (SIGKILL) is the OOM killer's signature.
# Naming it in the record is what turns an anonymous kill into data.
if [ "$rc" -gt 128 ]; then
  sig=$((rc - 128))
  how="signal=$sig$( [ "$sig" = 9 ] && echo ' (SIGKILL, probably the OOM killer)' )"
else
  how="exit=$rc"
fi

jfr_size=0
[ -n "${JFR_FILE:-}" ] && [ -f "$JFR_FILE" ] && jfr_size=$(stat -c %s "$JFR_FILE" 2>/dev/null || echo 0)

printf '%s coordinator-exit %s uptime_s=%d last_rss_mb=%d peak_rss_mb=%d last_avail_mb=%d avail_now_mb=%d jvms_now=%d jfr_bytes=%d jfr=%s sample_age_s<=%d\n' \
  "$(date -Is)" "$how" "$(( $(date +%s) - start_epoch ))" \
  "$last_rss" "$last_hwm" "$last_avail" \
  "$(awk '/MemAvailable/{print int($2/1024)}' /proc/meminfo)" \
  "$(pgrep -c java 2>/dev/null || echo 0)" \
  "$jfr_size" "${JFR_FILE:-none}" \
  "${HIVE_DEATHLOG_INTERVAL:-10}" \
  | tee -a "$DEATHLOG" >&2

exit "$rc"
