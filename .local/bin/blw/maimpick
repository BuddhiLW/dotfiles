#!/bin/bash

# Screenshot picker using maim.

output="$(date '+%y%m%d-%H%M-%S').png"
xclip_cmd="xclip -sel clip -t image/png"

take_selection() {
    maim -s "$@"
}

take_window() {
    local wid
    wid=$(xdotool getactivewindow 2>/dev/null ||
          xprop -root _NET_ACTIVE_WINDOW | awk -F'# ' '{print $2}')
    maim -q -i "$wid" "$@"
}

take_fullscreen() {
    maim -q "$@"
}

choice="$(printf "a selected area\ncurrent window\nfull screen\na selected area (copy)\ncurrent window (copy)\nfull screen (copy)" | dmenu -l 6 -i -p "Screenshot which area?")"

case "$choice" in
    "a selected area")       take_selection pic-selected-"${output}" ;;
    "current window")        take_window pic-window-"${output}" ;;
    "full screen")           take_fullscreen pic-full-"${output}" ;;
    "a selected area (copy)") take_selection | ${xclip_cmd} ;;
    "current window (copy)") take_window | ${xclip_cmd} ;;
    "full screen (copy)")    take_fullscreen | ${xclip_cmd} ;;
esac
