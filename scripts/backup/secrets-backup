#!/usr/bin/env bash
# Copy every secret on this machine to the encrypted pendrive.
#   secrets-backup [DEST]        DEST defaults to $SECRETS_ROOT/secrets-YYYY-MM-DD
#   SYSTEM=1 secrets-backup      also root-owned secrets (wifi, wireguard, ssh host keys)
#   SKIP_GPG_EXPORT=1 ...        don't ask for the passphrase (keyring is still copied)
# Safe to re-run: it updates DEST in place. Prints paths and counts, never contents.
set -Eeuo pipefail

DOTFILES="${DOTFILES:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
source "$DOTFILES/scripts/backup/lib"

mountpoint -q "$SECRETS_ROOT" || die "$SECRETS_ROOT is not mounted (unlock the pendrive first)"
[ -w "$SECRETS_ROOT" ] || die "$SECRETS_ROOT is not writable"
DEST="${1:-$SECRETS_ROOT/secrets-$(date +%F)}"
umask 077
mkdir -p "$DEST/home" "$DEST/gpg-export"
exec 9>"$DEST/.lock"
flock -n 9 || die "another secrets-backup is writing to $DEST"
cd "$HOME"

# 1. Known secret stores, relative paths preserved.
shopt -s nullglob
list=()
for p in "${SECRET_PATHS[@]}"; do
  for m in $p; do [ -e "$m" ] && list+=("$m"); done
done
log "copying ${#list[@]} secret paths"
rc=0
sx=(); for x in "${SECRET_RSYNC_EXCLUDES[@]}"; do sx+=(--exclude="/$x"); done
rsync -aR --exclude='S.*' --exclude='*.lock' --exclude='cache2' --exclude='startupCache' \
      "${sx[@]}" "${list[@]}" "$DEST/home/" || rc=$?
[ "$rc" = 0 ] || [ "$rc" = 24 ] || warn "rsync exit $rc on secret paths (some files unreadable?)"

# 2. Stray secret files (.env, *.pem, ...) anywhere in $HOME. Unreadable dirs
#    (root-owned docker layers etc.) are expected; they must not stop the run.
log "searching \$HOME for stray secret files (.env, *.pem, *.key, ...)"
prune=(); for d in "${SECRET_FIND_PRUNE[@]}"; do prune+=(-name "$d" -o); done
names=(); for n in "${SECRET_FIND_NAMES[@]}"; do names+=(-name "$n" -o); done
find . -xdev \( "${prune[@]:0:${#prune[@]}-1}" \) -prune -o \
     -type f \( "${names[@]:0:${#names[@]}-1}" \) \
     ! -name '*.example' ! -name '*.sample' ! -name '*.template' ! -name '*.dist' \
     -size -20M -print0 2>/dev/null > "$DEST/stray.list0" || true
n=$(tr -cd '\0' < "$DEST/stray.list0" | wc -c)
log "copying $n stray secret files (list: $DEST/stray.list0)"
rc=0; rsync -aR --from0 --files-from="$DEST/stray.list0" . "$DEST/home/" || rc=$?
[ "$rc" = 0 ] || [ "$rc" = 24 ] || warn "rsync exit $rc on stray files"

# 3. GPG keys exported on their own, so restore does not depend on the keyring
#    format of whatever gpg the new machine ships. --export-secret-keys already
#    includes subkeys, so pinentry asks once. Written to .tmp and renamed, so an
#    interrupted export can never leave a truncated key that looks valid.
if [ "${SKIP_GPG_EXPORT:-0}" != 1 ]; then
  export GPG_TTY="${GPG_TTY:-$(tty 2>/dev/null || true)}"
  G="$DEST/gpg-export"
  log "exporting gpg keys (pinentry will ask for your passphrase)"
  gpg --armor --export             > "$G/public-keys.asc.tmp"
  gpg --armor --export-secret-keys > "$G/secret-keys.asc.tmp"
  gpg --export-ownertrust          > "$G/ownertrust.txt.tmp"
  grep -q 'BEGIN PGP PRIVATE KEY BLOCK' "$G/secret-keys.asc.tmp" \
    || { rm -f "$G"/*.tmp; die "secret key export came out empty (wrong passphrase / cancelled?)"; }
  for f in public-keys.asc secret-keys.asc ownertrust.txt; do mv -f "$G/$f.tmp" "$G/$f"; done
  rm -f "$G/secret-subkeys.asc"
  log "gpg keys exported"
fi

# 4. Secrets too big for the pendrive, encrypted to your own public key onto the HDD.
if [ "${#BIG_SECRETS[@]}" -gt 0 ]; then
  if mountpoint -q "$BULK_ROOT"; then
    rcpt=$(head -1 "$HOME/.local/share/password-store/.gpg-id")
    BD="$BULK_ROOT/secrets-encrypted"; mkdir -p "$BD"
    for b in "${BIG_SECRETS[@]}"; do
      [ -e "$b" ] || continue
      out="$BD/$(printf '%s' "$b" | tr '/' '_').tar.zst.gpg"
      log "encrypting $b -> $out"
      tar -C "$HOME" -cf - "$b" | zstd -q -T0 -3 | gpg --batch --yes --trust-model always \
        --encrypt --recipient "$rcpt" --output "$out.part"
      mv -f "$out.part" "$out"
    done
  else
    warn "$BULK_ROOT not mounted: skipped encrypting ${BIG_SECRETS[*]} to the HDD"
  fi
fi

for m in "${PASS_MIRRORS[@]}"; do
  if mountpoint -q "$(dirname "$m")"; then
    mkdir -p "$m"; chmod 700 "$m"
    rsync -a --delete "$HOME/.local/share/password-store/" "$m/" && log "pass store mirrored to $m"
  else
    warn "$(dirname "$m") not mounted: pass store mirror $m skipped"
  fi
done

# 5. Root-owned secrets, opt-in.
if [ "${SYSTEM:-0}" = 1 ]; then
  log "copying system secrets (sudo)"
  mkdir -p "$DEST/system"
  for p in /etc/NetworkManager/system-connections /etc/wireguard /etc/ssh \
           /etc/openvpn /etc/zfs/zroot-keys /run/keystore/rpool; do
    if sudo test -e "$p"; then sudo rsync -aR "$p" "$DEST/system/"; fi
  done
  sudo chown -R "$USER:" "$DEST/system"
fi

# 6. Manifest, so secrets-verify can prove nothing rotted on the stick.
log "writing SHA256SUMS"
(cd "$DEST" && find . -type f ! -name SHA256SUMS ! -name SHA256SUMS.tmp ! -name .lock -print0 | sort -z \
   | xargs -0 sha256sum > SHA256SUMS.tmp && mv SHA256SUMS.tmp SHA256SUMS)
sync -f "$DEST"
log "done: $DEST ($(du -sh "$DEST" | cut -f1), $(wc -l < "$DEST/SHA256SUMS") files), $(df -h --output=avail "$SECRETS_ROOT" | tail -1 | tr -d ' ') free"
log "next: $DOTFILES/scripts/backup/secrets-verify $DEST"
