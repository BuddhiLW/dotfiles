#!/usr/bin/env bash
# PROVE the secrets backup is restorable, using nothing but the backup itself.
#   secrets-verify [DIR]      DIR defaults to the newest $SECRETS_ROOT/secrets-*
#
# The proof: a brand-new, empty GNUPGHOME imports ONLY the exported key from the
# backup, then decrypts every entry of the BACKED-UP password store. If that
# works, the stick alone plus your passphrase is enough to open `pass`.
# Decrypted output goes to /dev/null; only counts are printed.
set -Eeuo pipefail

DOTFILES="${DOTFILES:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
source "$DOTFILES/scripts/backup/lib"

DIR="${1:-$(latest_dir "$SECRETS_ROOT" secrets)}"
[ -d "$DIR" ] || die "no backup dir found (looked in $SECRETS_ROOT)"
log "verifying $DIR"
fail=0

# 1. Integrity: every file still matches the manifest.
if (cd "$DIR" && sha256sum --quiet -c SHA256SUMS); then
  log "checksums OK ($(wc -l < "$DIR/SHA256SUMS") files)"
else
  warn "checksum mismatch"; fail=1
fi

# 2. The key opens the store, in isolation from ~/.gnupg.
STORE="$DIR/home/.local/share/password-store"
[ -d "$STORE" ] || die "password store missing from backup"
G=$(mktemp -d); trap 'gpgconf --homedir "$G" --kill all 2>/dev/null; rm -rf "$G"' EXIT
chmod 700 "$G"
export GPG_TTY="${GPG_TTY:-$(tty 2>/dev/null || true)}"
gpg --homedir "$G" --batch --quiet --import "$DIR/gpg-export/secret-keys.asc" 2>/dev/null \
  || die "secret key export does not import"
gpg --homedir "$G" --batch --quiet --import-ownertrust "$DIR/gpg-export/ownertrust.txt" 2>/dev/null || true

mapfile -d '' entries < <(find "$STORE" -name '*.gpg' -not -path '*/.git/*' -print0)
log "decrypting ${#entries[@]} pass entries with the backed-up key (pinentry asks once)"
ok=0; bad=()
for f in "${entries[@]}"; do
  if gpg --homedir "$G" --quiet --decrypt "$f" >/dev/null 2>&1; then
    ok=$((ok+1))
  else
    bad+=("${f#$STORE/}")
  fi
done
if [ "${#bad[@]}" -eq 0 ]; then
  log "PROVEN: $ok/${#entries[@]} pass entries decrypt with the key on the stick"
else
  warn "$ok/${#entries[@]} decrypt; these do not:"; printf '   %s\n' "${bad[@]}" >&2; fail=1
fi
[ -d "$STORE/.git" ] && { git -C "$STORE" fsck --no-dangling >/dev/null 2>&1 \
  && log "password-store git history OK" || { warn "password-store git fsck failed"; fail=1; }; }

# 3. SSH private keys parse and match their .pub (fingerprints compared, not shown).
for k in "$DIR"/home/.ssh/*; do
  [ -f "$k.pub" ] || continue
  a=$(ssh-keygen -l -f "$k.pub" 2>/dev/null | awk '{print $2}')
  b=$(ssh-keygen -l -f "$k"     2>/dev/null | awk '{print $2}')
  if [ -n "$a" ] && [ "$a" = "$b" ]; then log "ssh key OK: ${k##*/}"
  else warn "ssh key MISMATCH or unreadable: ${k##*/}"; fail=1; fi
done

# 4. Big secrets encrypted onto the HDD: they must decrypt (with your real
#    keyring) and decompress cleanly. Nothing is written out.
for f in "$BULK_ROOT"/secrets-encrypted/*.tar.zst.gpg; do
  [ -f "$f" ] || continue
  if gpg --quiet --decrypt "$f" 2>/dev/null | zstd -tq; then log "encrypted OK: ${f##*/}"
  else warn "encrypted copy does not decrypt/decompress: ${f##*/}"; fail=1; fi
done

[ "$fail" = 0 ] && log "backup verified" || die "backup has problems (see above)"
