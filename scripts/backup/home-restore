#!/usr/bin/env bash
# Restore a home-backup into $HOME: the rsync mirror (home/), the per-unit
# tar archives (archives/), and the datahike KG archive (../kg/).
#   home-restore [SRC]      SRC defaults to $BULK_ROOT/home-data
#   FORCE=1 home-restore    overwrite files that already exist (default: keep them)
#   JOBS=4 home-restore     parallel extract streams
set -Eeuo pipefail

DOTFILES="${DOTFILES:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
source "$DOTFILES/scripts/backup/lib"

SRC="${1:-$BULK_ROOT/home-data}"
[ -d "$SRC" ] || die "no home-data found at $SRC"
JOBS="${JOBS:-4}"
command -v zstd >/dev/null || sudo apt-get install -y zstd
log "restoring $SRC -> $HOME"

# 1. rsync mirror (units backed up before the switch to tar mode).
if [ -d "$SRC/home" ]; then
  keep=--ignore-existing; [ "${FORCE:-0}" = 1 ] && keep=
  log "mirror: $SRC/home"
  rsync -aHAX $keep "$SRC/home/" "$HOME/"
fi

# 2. per-unit archives.
if compgen -G "$SRC/archives/*.tar.zst" >/dev/null; then
  keep=--skip-old-files; [ "${FORCE:-0}" = 1 ] && keep=--overwrite
  export keep
  log "archives: $(ls "$SRC"/archives/*.tar.zst | wc -l) in $SRC/archives ($JOBS at a time)"
  find "$SRC/archives" -maxdepth 1 -name '*.tar.zst' -print0 \
    | xargs -0 -P "$JOBS" -I{} bash -c \
        'zstd -dc "$1" | tar -C "$HOME" -xpf - $keep || echo "FAILED $(basename "$1")"' _ {}
fi

# 3. datahike KG (archived from a ZFS snapshot, one tar per name prefix).
KG=$(ls -1d "$BULK_ROOT"/kg/datahike-*/ 2>/dev/null | sort | tail -1)
# ~/.local is a link into dotfiles, created by setup/init AFTER this runs;
# restoring under $HOME/.local now would land in a dir that init moves aside.
KGDEST="$HOME/.local/share/hive-mcp"
[ -d "$DOTFILES/.local" ] && KGDEST="$DOTFILES/.local/share/hive-mcp"
if [ -n "$KG" ]; then
  if [ -e "$KGDEST/datahike" ] && [ "${FORCE:-0}" != 1 ]; then
    warn "KG: $KGDEST/datahike exists; left alone (FORCE=1 to restore over it)"
  else
    (cd "$KG" && sha256sum --quiet -c SHA256SUMS) || die "KG archive checksum mismatch in $KG"
    mkdir -p "$KGDEST"
    log "KG: restoring $(ls "$KG"/part-*.tar.zst | wc -l) parts -> $KGDEST/datahike"
    ls "$KG"/part-*.tar.zst | xargs -P "$JOBS" -I{} bash -c 'zstd -dc "$1" | tar -C "$2" -xpf -' _ {} "$KGDEST"
    log "KG: $(find "$KGDEST/datahike" | wc -l) entries restored"
  fi
fi
log "done"
