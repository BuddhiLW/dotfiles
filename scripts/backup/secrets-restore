#!/usr/bin/env bash
# Put the secrets from the pendrive back into $HOME on a fresh (or existing) system.
#   secrets-restore [DIR]      DIR defaults to the newest $SECRETS_ROOT/secrets-*
#   SYSTEM=1 secrets-restore   also restore root-owned secrets (wifi, wireguard, ...)
# Anything it would overwrite is kept as <file>.pre-restore.
set -Eeuo pipefail

DOTFILES="${DOTFILES:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
source "$DOTFILES/scripts/backup/lib"

DIR="${1:-$(latest_dir "$SECRETS_ROOT" secrets)}"
[ -d "$DIR/home" ] || die "no backup found (unlock/mount the pendrive at $SECRETS_ROOT, or pass DIR)"
command -v gpg >/dev/null || sudo apt-get install -y gnupg
command -v pass >/dev/null || sudo apt-get install -y pass

log "restoring secrets from $DIR"
rsync -a --backup --suffix=.pre-restore "$DIR/home/" "$HOME/"

# Permissions ssh and gpg insist on.
chmod 700 "$HOME/.ssh" "$HOME/.gnupg" 2>/dev/null || true
find "$HOME/.ssh" -type f ! -name '*.pub' -exec chmod 600 {} + 2>/dev/null || true
find "$HOME/.gnupg" -type d -exec chmod 700 {} + 2>/dev/null || true
find "$HOME/.gnupg" -type f -exec chmod 600 {} + 2>/dev/null || true

# pass looks at ~/.password-store; the real store lives under XDG data.
[ -L "$HOME/.password-store" ] || [ ! -e "$HOME/.password-store" ] \
  && ln -sfn "$HOME/.local/share/password-store" "$HOME/.password-store"

# Import the exported keys too: covers a new gpg that can't read the copied keyring.
export GPG_TTY="${GPG_TTY:-$(tty 2>/dev/null || true)}"
gpgconf --kill gpg-agent 2>/dev/null || true
gpg --batch --quiet --import "$DIR/gpg-export/public-keys.asc" 2>/dev/null || true
gpg --batch --quiet --import "$DIR/gpg-export/secret-keys.asc" 2>/dev/null || true
gpg --batch --quiet --import-ownertrust "$DIR/gpg-export/ownertrust.txt" 2>/dev/null || true

for f in "$BULK_ROOT"/secrets-encrypted/*.tar.zst.gpg; do
  [ -f "$f" ] || continue
  log "decrypting ${f##*/} into \$HOME (existing files kept)"
  gpg --quiet --decrypt "$f" | zstd -dc | tar -C "$HOME" --skip-old-files -xf - \
    || warn "could not restore ${f##*/}"
done

if [ "${SYSTEM:-0}" = 1 ] && [ -d "$DIR/system" ]; then
  log "restoring system secrets (sudo)"
  sudo rsync -a --backup --suffix=.pre-restore "$DIR/system/" /
  sudo chown -R root:root /etc/NetworkManager/system-connections /etc/wireguard 2>/dev/null || true
  sudo chmod 600 /etc/NetworkManager/system-connections/* 2>/dev/null || true
fi

# Smoke test: the store lists and one entry decrypts (value discarded).
n=$(find "$HOME/.password-store/" -name '*.gpg' -not -path '*/.git/*' | wc -l)
first=$(find "$HOME/.password-store/" -name '*.gpg' -not -path '*/.git/*' | head -1)
if [ -n "$first" ] && gpg --quiet --decrypt "$first" >/dev/null 2>&1; then
  log "pass works ($n entries)"
else
  warn "pass store restored ($n entries) but test decrypt failed; run secrets-verify"
fi
log "done"
