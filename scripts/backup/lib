#!/usr/bin/env bash
# Shared config for scripts/backup/*. Sourced, not executed.

# Encrypted pendrive (LUKS, sdb2) and the 1TB external HDD.
SECRETS_ROOT="${SECRETS_ROOT:-/mnt/hd2}"
BULK_ROOT="${BULK_ROOT:-$HOME/mount}"

# Everything secret, relative to $HOME. Globs allowed; missing paths are skipped.
# The password store is listed by its REAL path: ~/.password-store is a symlink
# and copying the link alone saves nothing.
SECRET_PATHS=(
  .ssh
  .gnupg
  .local/share/password-store
  .local/share/keyrings
  .pki
  .kube
  .docker/config.json
  .config/gh
  .config/rclone
  .config/stripe
  .config/doctl
  .config/gcloud
  .config/hive-mcp
  .config/monero-project
  .aws
  .azure
  .terraform.d
  .npmrc
  .pypirc
  .netrc
  .pgpass
  .git-credentials
  .gitconfig
  .authinfo
  .authinfo.gpg
  .m2/settings.xml
  .m2/settings-security.xml
  .cargo/credentials.toml
  .lein/credentials.clj.gpg
  .lein/profiles.clj
  .claude/.credentials.json
  .mozilla
  Monero/wallets
  snap/firefox/common/.mozilla/firefox
  'snap/thunderbird/common/.thunderbird/*/key4.db'
  'snap/thunderbird/common/.thunderbird/*/logins.json'
  'snap/thunderbird/common/.thunderbird/*/cert9.db'
  snap/thunderbird/common/.thunderbird/profiles.ini
  snap/element-desktop/current/.config/Element
  snap/slack/current/.config/Slack/Cookies
  # k8s / talos cluster access: kubeconfig, talosconfig, machine configs (all git-ignored)
  .talos
  dotfiles/talos
  # monero GUI wallets + settings (inside a build tree main.sh used to rm -rf)
  'dotfiles/gitthings/*/build/*/bin/monero-storage'
)
# Extra copies of the pass store. Entries are gpg-encrypted, so an unencrypted
# disk is acceptable here (only entry NAMES are visible). Skipped if not mounted.
PASS_MIRRORS=(/mnt/hd5/password-store)

# Left out of the pendrive copy for size; see BIG_SECRETS.
SECRET_RSYNC_EXCLUDES=(dotfiles/talos/db.snapshot dotfiles/talos/etcd-backup-20260802-pre-defrag.snapshot .kube/cache)

# Secrets too big for the pendrive: tar | zstd | gpg-encrypted to your own key
# (public key only, no passphrase needed), stored on the HDD.
BIG_SECRETS=(dotfiles/talos/db.snapshot dotfiles/talos/etcd-backup-20260802-pre-defrag.snapshot)

# Docker (rootless) named volumes. Archived through docker itself; containers
# using a volume are paused while it is read, so the copy is consistent.
DOCKER_VOLUMES_SECRET=(   # wallets / payment state -> encrypted pendrive
  vtranslate_monero-wallet vtranslate_monero-customer-wallet
  vtranslate_moneropay-data dc_xmr_wallet_data
)
DOCKER_VOLUMES_BULK=(     # data that cannot be re-derived -> HDD
  cve-mongo-data hive-mcp_hive-qdrant-carto-data
)

# Stray secret files anywhere in $HOME (.env, *.pem, ...) are collected by
# name; these dirs are never descended into while looking.
SECRET_FIND_PRUNE=(node_modules .cache Trash .git target .m2 .npm .venv venv docker pipx
                   site-packages __pycache__ anaconda3 nuclei-templates clones-ref
                   gitthings testdata .codex .tmp
                   .ollama .cargo .rustup .gradle .cpcache snap go)
SECRET_FIND_NAMES=('.env' '.env.*' '*.pem' '*.key' '*.p12' '*.pfx' '*.kdbx'
                   '*.jks' '*.keystore' '*.ovpn' '*.age' '*.p8' '*.ppk'
                   'service-account*.json' 'kubeconfig*' '*.conf.wg')

# Bulk backup is an allow-list: every top-level NON-dot directory of $HOME,
# minus these reinstallable ones. Top-level dot-dirs are all skipped (secrets
# go to the pendrive; the rest is reinstallable). Loose top-level files are kept.
BULK_SKIP_TOP=(
  "VirtualBox VMs" anaconda3 miniconda3 Android snap go sdk fpcup fpcupdeluxe
  quicklisp nuclei-templates ref-projects test-lf mount mount_hd2 mount_sda1 bin
)
# Extra dot-dirs to include anyway (e.g. .claude .emacs.d).
BULK_EXTRA_DOT=()

# Rebuildable junk left out inside the kept trees (rsync patterns). Any dir
# holding a CACHEDIR.TAG (cargo target/, many caches) is skipped automatically.
BULK_EXCLUDES=(
  node_modules .cache .local/share/Trash .npm .cpcache __pycache__ .pytest_cache
  .venv venv .gradle/caches .m2/repository .cargo/registry .cargo/git .rustup
  .stack-work .shadow-cljs .lsp/.cache .clj-kondo/.cache .ccls-cache
  'snap/*/common/.cache' .local/share/Steam/steamapps .android/avd
  '*.tmp' '*.swp' .thumbnails
  # re-pullable images/layers (docker volumes are kept: they can hold real data)
  .local/share/docker/containerd .local/share/docker/overlay2
  .local/share/docker/image .local/share/docker/buildkit
  .local/share/pipx/venvs anaconda3/pkgs
  dotfiles/.local/share/docker dotfiles/.local/share/containers dotfiles/.local/share/pnpm
  dotfiles/.local/share/Steam dotfiles/.local/share/virtualenvs dotfiles/gitthings
)

log()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31mxx\033[0m %s\n' "$*" >&2; exit 1; }

# Latest dated dir under $1 matching $2-YYYY-MM-DD*.
latest_dir() { local d; d=$(ls -1d "$1/$2"-*/ 2>/dev/null | sort | tail -1); printf "%s" "${d%/}"; }
