#!/usr/bin/bash

# Official Clojure CLI (deps.edn tooling) under ~/.local, no sudo. Ubuntu's
# `clojure` package is plain Clojure without deps.edn support; ~/.local/bin
# comes first on PATH, so this one wins.
tmp=$(mktemp -d)
curl -fsSL -o "$tmp/linux-install.sh" https://github.com/clojure/brew-install/releases/latest/download/linux-install.sh
bash "$tmp/linux-install.sh" --prefix "$HOME/.local"
rm -rf "$tmp"
clojure -Sdescribe | head -n 2

## Clojure formatting
/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/weavejester/cljfmt/HEAD/install.sh)"
