#!/usr/bin/bash

mkdir -p $HOME/.config/xmonad && cd $HOME/.config/xmonad
[ -d xmonad ] || git clone https://github.com/xmonad/xmonad
[ -d xmonad-contrib ] || git clone https://github.com/xmonad/xmonad-contrib

## Install Haskell and Stack package manager for haskell
command -v stack >/dev/null || curl -sSL https://get.haskellstack.org/ | sh

stack init --force
stack update
stack upgrade
stack install   # builds and copies xmonad to ~/.local/bin
