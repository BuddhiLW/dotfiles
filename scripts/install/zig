#!/usr/bin/bash
# Install a pinned Zig toolchain from ziglang.org into ~/.local.
#
#   ./zig            # installs the default version below
#   ./zig 0.15.2     # installs a specific version
#   ./zig master     # installs the current nightly
#
# Versioned installs live side by side under ~/.local/share/zig/<version>;
# ~/.local/bin/zig is a symlink, so switching versions is one re-run.
#
# Pinned because ClojureWasm (~/PP/hive/clones-ref/ClojureWasm) requires
# exactly 0.16.0 -- see its build.zig.zon .minimum_zig_version and flake.nix.

set -euo pipefail

VERSION="${1:-0.16.0}"
PREFIX="$HOME/.local"
SHARE="$PREFIX/share/zig"
BIN="$PREFIX/bin"

# --- resolve the tarball + checksum from the official index -----------------
case "$(uname -s)" in
  Linux)  OS=linux ;;
  Darwin) OS=macos ;;
  *) echo "unsupported OS: $(uname -s)" >&2; exit 1 ;;
esac
case "$(uname -m)" in
  x86_64|amd64)  ARCH=x86_64 ;;
  aarch64|arm64) ARCH=aarch64 ;;
  *) echo "unsupported arch: $(uname -m)" >&2; exit 1 ;;
esac
TARGET="$ARCH-$OS"

read -r URL SHA < <(
  curl -fsSL https://ziglang.org/download/index.json |
  python3 -c "
import json,sys
d=json.load(sys.stdin)
v=d.get('$VERSION')
if v is None:
    sys.exit('no such Zig version: $VERSION (have: %s)' % ', '.join(list(d)[:8]))
t=v.get('$TARGET')
if t is None:
    sys.exit('Zig $VERSION has no $TARGET build')
print(t['tarball'], t['shasum'])"
)

# 'master' is a moving target -- resolve it to the real version it reports.
if [ "$VERSION" = master ]; then
  VERSION="$(basename "$URL" .tar.xz | sed "s/^zig-$TARGET-//")"
  echo "master currently resolves to $VERSION"
fi

DEST="$SHARE/$VERSION"
if [ -x "$DEST/zig" ]; then
  echo "Zig $VERSION already installed at $DEST"
else
  TMP="$(mktemp -d)"
  trap 'rm -rf "$TMP"' EXIT

  echo "downloading $URL"
  curl -fL --progress-bar -o "$TMP/zig.tar.xz" "$URL"

  echo "verifying sha256"
  echo "$SHA  $TMP/zig.tar.xz" | sha256sum -c -

  echo "extracting to $DEST"
  mkdir -p "$DEST"
  tar -xJf "$TMP/zig.tar.xz" -C "$DEST" --strip-components=1
fi

# --- link it onto PATH ------------------------------------------------------
mkdir -p "$BIN"
ln -sfn "$DEST/zig" "$BIN/zig"

echo
"$BIN/zig" version
echo "installed: $DEST"
echo "linked:    $BIN/zig"

case ":$PATH:" in
  *":$BIN:"*) ;;
  *) echo "NOTE: $BIN is not on your PATH -- add it to your shell rc." ;;
esac
