#!/usr/bin/env bash
set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/dotfiles}"

bash "$DOTFILES/scripts/install/electron"
electron_binary="$(command -v electron)"

cd "$DOTFILES/gitthings/"

if [[ ! -d nibbler ]]; then
  git clone https://github.com/rooklift/nibbler.git
fi

NIBBLER_PATH="$PWD/nibbler"
PATH_FILE="/usr/local/bin/nibbler"

sudo tee "$PATH_FILE" >/dev/null <<EOF
#!/usr/bin/env bash
set -e
cd "$NIBBLER_PATH/files/src/"
exec "$electron_binary" .
EOF

sudo chmod a+x "$PATH_FILE"

