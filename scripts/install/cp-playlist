#!/usr/bin/env bash
set -euo pipefail

if [ $# -ne 3 ]; then
  echo "Usage: $0 <playlist.txt> <source_dir|filelist> <dest_dir>" >&2
  exit 1
fi

LIST="$1"
SRC="$2"
DEST="$3"

mkdir -p "$DEST"
MATCHED="$DEST/matched.log"
UNMATCHED="$DEST/unmatched.log"
AMBIG="$DEST/ambiguous.log"
: > "$MATCHED"; : > "$UNMATCHED"; : > "$AMBIG"

normalize() {
  sed -E '
    s/^[[:space:]]*[0-9]+[.)-]?[[:space:]]*//;
    s/^[[:space:]]*#.*$//;
    s/\(\?\)//g;
  ' | tr '[:upper:]' '[:lower:]'
}

tokens_from() {
  local loose
  loose="$(sed -E 's/\([^)]*\)//g; s/\bfeat\.?\b.*//g; s/[;&:@/|]/ /g; s/[-–—]/ /g; s/,+/ /g; s/[[:space:]]+/ /g; s/^ | $//g')"
  awk '{for(i=1;i<=NF;i++){t=$i;gsub(/[^[:alnum:]]/,"",t);if(length(t)>=2)print t;}}' <<<"$loose"
}

predicate_for_tokens() {
  local toks=("$@")
  mapfile -t top < <(printf "%s\n" "${toks[@]}" | awk '{print length, $0}' | sort -nr | head -n3 | cut -d' ' -f2-)
  [ ${#top[@]} -eq 0 ] && return 1
  printf ' -type f '
  for t in "${top[@]}"; do
    printf ' -iname *%s* ' "$t"
  done
}

copy_one() {
  local src="$1"
  rsync -a --ignore-existing -- "$src" "$DEST/"
}

# Filelist mode
if [ -f "$SRC" ]; then
  while IFS= read -r p || [ -n "$p" ]; do
    [[ -z "${p// }" ]] && continue
    [[ "$p" =~ ^[[:space:]]*# ]] && continue
    eval "p_expanded=\"$p\""
    if [ -f "$p_expanded" ]; then
      copy_one "$p_expanded"
      echo "$p_expanded" >>"$MATCHED"
    else
      echo "$p" >>"$UNMATCHED"
    fi
  done < <(tr -d '\r' < "$SRC")
  echo "Filelist mode complete."
  exit 0
fi

# Playlist search mode
while IFS= read -r raw || [ -n "$raw" ]; do
  norm="$(printf '%s' "$raw" | normalize)"
  [[ -z "${norm// }" ]] && continue

  mapfile -t toks < <(printf '%s\n' "$norm" | tokens_from)
  if [ ${#toks[@]} -eq 0 ]; then
    echo "MISS: $raw" | tee -a "$UNMATCHED"
    continue
  fi

  mapfile -t hits < <(eval "find \"$SRC\" $(predicate_for_tokens "${toks[@]}") 2>/dev/null" || true)

  if [ ${#hits[@]} -eq 0 ]; then
    longest="$(printf '%s\n' "${toks[@]}" | awk '{print length,$0}' | sort -nr | head -n1 | cut -d' ' -f2-)"
    mapfile -t hits < <(find "$SRC" -type f -iname "*$longest*" 2>/dev/null || true)
  fi

  if [ ${#hits[@]} -eq 0 ]; then
    echo "MISS: $raw" | tee -a "$UNMATCHED"
    continue
  fi

  best_idx=-1; best_score=-1
  scores=()
  for i in "${!hits[@]}"; do
    base="$(basename "${hits[$i]}" | tr '[:upper:]' '[:lower:]')"
    s=0
    for t in "${toks[@]}"; do [[ "$base" == *"$t"* ]] && s=$((s+1)); done
    scores[$i]=$s
    if [ $s -gt $best_score ]; then best_score=$s; best_idx=$i; fi
  done

  chosen="${hits[$best_idx]}"

  same_top=()
  for i in "${!hits[@]}"; do
    [ "${scores[$i]}" -eq "$best_score" ] && same_top+=("$i")
  done
  if [ ${#same_top[@]} -gt 1 ]; then
    {
      echo "AMBIGUOUS: $raw"
      for i in "${same_top[@]}"; do
        echo "  ${hits[$i]}  [score=${scores[$i]}]"
      done
      echo
    } >>"$AMBIG"
  fi

  copy_one "$chosen"
  echo "OK: $raw -> $chosen" | tee -a "$MATCHED"

done < <(tr -d '\r' < "$LIST")

