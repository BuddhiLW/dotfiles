#!/usr/bin/env bash
# Flutter SDK, from the official release index, with the archive's sha256
# checked before anything is unpacked. No snap, no Android Studio.
#
#   0  flutter is installed at the wanted version (rerun-safe: each step
#      checks before it acts, and an install already at that version is kept)
#   1  a step failed; its output is above
#   2  the script could not run (no network, no release matching the request)
#
# The Android half lives in ./android and is NOT run from here: a machine that
# only compiles ClojureDart, or targets linux/web, does not need it.
#
# Override through the environment:
#   FLUTTER_VERSION=3.44.1 ./flutter   pin a release; default is the channel's current
#   FLUTTER_CHANNEL=beta ./flutter     stable | beta
#   FLUTTER_HOME=/opt/flutter ./flutter
#   FLUTTER_LINUX_DESKTOP=0 ./flutter  skip the toolchain `flutter run -d linux` needs
#   SKIP_APT=1 ./flutter               only report missing packages
set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/dotfiles}"
FLUTTER_HOME="${FLUTTER_HOME:-$DOTFILES/gitthings/flutter}"
FLUTTER_HOME="${FLUTTER_HOME%/}"
CHANNEL="${FLUTTER_CHANNEL:-stable}"
WANTED="${FLUTTER_VERSION:-}"
LINUX_DESKTOP="${FLUTTER_LINUX_DESKTOP:-1}"
BASE="https://storage.googleapis.com/flutter_infra_release/releases"
INDEX="$BASE/releases_linux.json"

step() { printf '\n== %s\n' "$*"; }
die()  { printf 'flutter: %s\n' "$2" >&2; exit "$1"; }

case "$(uname -m)" in
  x86_64) ;;
  *) die 2 "the release index only publishes linux x64 archives; this is $(uname -m). Use a git checkout of the channel instead." ;;
esac

step "system packages"
pkgs=(curl git unzip xz-utils zip libglu1-mesa jq)
if [ "$LINUX_DESKTOP" = 1 ]; then
  pkgs+=(clang cmake ninja-build pkg-config libgtk-3-dev liblzma-dev libstdc++-12-dev mesa-utils)
fi
missing=()
# Status, not `dpkg -s`: that one also exits 0 for a package that was removed
# and left its config behind.
installed_pkg() { [ "$(dpkg-query -W -f='${db:Status-Status}' "$1" 2>/dev/null)" = installed ]; }
for p in "${pkgs[@]}"; do installed_pkg "$p" || missing+=("$p"); done
if ((${#missing[@]})); then
  if [ "${SKIP_APT:-0}" = 1 ]; then
    echo "missing, not installed (SKIP_APT=1): ${missing[*]}"
  else
    sudo apt-get update -y
    sudo apt-get install -y "${missing[@]}"
  fi
else
  echo "all present"
fi
command -v jq >/dev/null || die 2 "jq is required to read the release index"

step "release"
index="$(curl -fsSL "$INDEX")" || die 2 "cannot fetch $INDEX"
if [ -n "$WANTED" ]; then
  release="$(jq -c --arg v "$WANTED" --arg c "$CHANNEL" \
    '[.releases[] | select(.version == $v and .channel == $c)][0] // empty' <<<"$index")"
  [ -n "$release" ] || die 2 "no $CHANNEL release $WANTED in the index"
else
  release="$(jq -c --arg c "$CHANNEL" \
    '.current_release[$c] as $h | [.releases[] | select(.hash == $h and .channel == $c)][0] // empty' <<<"$index")"
  [ -n "$release" ] || die 2 "the index names no current $CHANNEL release"
fi
version="$(jq -r .version <<<"$release")"
archive="$(jq -r .archive <<<"$release")"
sha256="$(jq -r .sha256 <<<"$release")"
echo "$CHANNEL $version  ($archive)"

step "sdk at $FLUTTER_HOME"
installed=""
[ -f "$FLUTTER_HOME/version" ] && installed="$(cat "$FLUTTER_HOME/version")"
if [ -z "$installed" ] && [ -f "$FLUTTER_HOME/bin/cache/flutter.version.json" ]; then
  installed="$(jq -r .frameworkVersion "$FLUTTER_HOME/bin/cache/flutter.version.json")"
fi
if [ "$installed" = "$version" ]; then
  echo "already $version"
else
  [ -n "$installed" ] && echo "replacing $installed"
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT
  curl -fL --progress-bar "$BASE/$archive" -o "$tmp/flutter.tar.xz"
  echo "$sha256  $tmp/flutter.tar.xz" | sha256sum -c - \
    || die 1 "sha256 mismatch on $archive; nothing was unpacked"
  # Unpack beside the target and swap, so a failed extraction never leaves a
  # half-written SDK where the PATH points.
  mkdir -p "$(dirname "$FLUTTER_HOME")"
  staging="$(mktemp -d -p "$(dirname "$FLUTTER_HOME")" .flutter-staging.XXXXXX)"
  tar -xJf "$tmp/flutter.tar.xz" -C "$staging" --strip-components=1
  if [ -e "$FLUTTER_HOME" ]; then
    old="$FLUTTER_HOME.replaced-$(date +%Y%m%d%H%M%S)"
    mv "$FLUTTER_HOME" "$old"
    echo "previous SDK kept at $old (delete it once the new one works)"
  fi
  mv "$staging" "$FLUTTER_HOME"
fi
export PATH="$FLUTTER_HOME/bin:$PATH"

step "configure"
# The archive is a git checkout owned by whoever built it.
git config --global --get-all safe.directory | grep -Fxq "$FLUTTER_HOME" \
  || git config --global --add safe.directory "$FLUTTER_HOME"
flutter --disable-analytics >/dev/null 2>&1 || true
if [ -n "${ANDROID_HOME:-}" ] && [ -d "${ANDROID_HOME%/}" ]; then
  flutter config --android-sdk "${ANDROID_HOME%/}" >/dev/null
  echo "android sdk: ${ANDROID_HOME%/}"
else
  echo "no ANDROID_HOME; run ./android for the Android toolchain"
fi
flutter precache --universal >/dev/null

step "PATH"
if grep -Fq "$FLUTTER_HOME/bin" "$HOME/.bashrc" 2>/dev/null \
   || grep -Fq "${FLUTTER_HOME/#$HOME/\$HOME}/bin" "$HOME/.bashrc" 2>/dev/null; then
  echo ".bashrc already exports $FLUTTER_HOME/bin"
else
  echo "add to your shell rc:  export PATH=\"$FLUTTER_HOME/bin:\$PATH\""
fi

if [ "$LINUX_DESKTOP" = 1 ] && installed_pkg libgtk-3-dev && ! pkg-config --exists gtk+-3.0 2>/dev/null; then
  step "pkg-config"
  # Measured 2026-09-21: libgtk-3-dev installed, and `flutter doctor` still
  # reported GTK missing, because Homebrew's pkg-config sat first on PATH and
  # does not search /usr/lib/x86_64-linux-gnu/pkgconfig.
  echo "libgtk-3-dev is installed but $(command -v pkg-config) cannot see gtk+-3.0."
  echo "A foreign pkg-config is shadowing /usr/bin/pkg-config. For linux desktop builds:"
  echo "  export PKG_CONFIG=/usr/bin/pkg-config   # or put /usr/bin ahead of it on PATH"
fi

step "doctor"
flutter --version
flutter doctor || true
