#!/usr/bin/env bash
# Fresh Ubuntu -> everything back: drives, secrets, /home data, rice, docker
# volumes, k8s access. Self-contained: run it before anything else exists.
#
#   plug in the LUKS pendrive and the 1TB "Expansion" HDD, then either
#     bash /media/$USER/Expansion/home-data/home/dotfiles/scripts/bootstrap
#   or
#     curl -fsSL https://raw.githubusercontent.com/BuddhiLW/dotfiles/ubuntu-xmonad/scripts/bootstrap | bash
#
# Safe to re-run: every step checks before it acts, restores never overwrite
# existing files, and a failed step can be retried by running this again.
set -Eeuo pipefail

# No drive identifiers live in this (public) file. The secrets pendrive is
# found by detection; it carries drives.env with the UUIDs of the others.
# Any of them can be forced: LUKS_DEV=/dev/sdX2 BACKUP_HDD_UUID=... bash bootstrap
REPO=https://github.com/BuddhiLW/dotfiles.git
BRANCH=ubuntu-xmonad
DOTFILES="$HOME/dotfiles"

log()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31mxx\033[0m %s\n' "$*" >&2; exit 1; }
[ "$(id -u)" != 0 ] || die "run as your user, not root (sudo is used where needed)"

log "base packages"
sudo apt-get update -qq
sudo apt-get install -y git curl rsync zstd gnupg pass cryptsetup pinentry-curses \
  util-linux ca-certificates

# -- drives ----------------------------------------------------------------------
mount_uuid() {  # uuid mountpoint
  local dev; dev=$(sudo blkid -U "$1" 2>/dev/null) || return 1
  mountpoint -q "$2" && return 0
  sudo mkdir -p "$2"; sudo mount "$dev" "$2"; sudo chown "$USER:" "$2"
}

log "secrets pendrive -> /mnt/hd2 (LUKS: asks for its passphrase)"
if ! mountpoint -q /mnt/hd2; then
  if [ -z "${LUKS_DEV:-}" ]; then
    # LUKS partitions on USB disks only (never the internal drive).
    mapfile -t cands < <(sudo blkid -t TYPE=crypto_LUKS -o device |
      while read -r d; do [ "$(lsblk -dno TRAN "/dev/$(lsblk -no PKNAME "$d" | head -1)" 2>/dev/null)" = usb ] && echo "$d"; done)
    case ${#cands[@]} in
      0) die "no LUKS partition on a USB disk; plug the secrets pendrive in (or set LUKS_DEV)" ;;
      1) LUKS_DEV=${cands[0]} ;;
      *) lsblk -o NAME,SIZE,MODEL,FSTYPE "${cands[@]}"
         read -rp "which one is the secrets pendrive? " LUKS_DEV </dev/tty ;;
    esac
  fi
  [ -e /dev/mapper/hd2 ] || sudo cryptsetup open "$LUKS_DEV" hd2
  sudo mkdir -p /mnt/hd2 && sudo mount /dev/mapper/hd2 /mnt/hd2
  sudo chown "$USER:" /mnt/hd2
fi
# shellcheck disable=SC1091
[ -f /mnt/hd2/drives.env ] && . /mnt/hd2/drives.env

log "backup HDD -> ~/mount"
if [ -n "${BACKUP_HDD_UUID:-}" ] && mount_uuid "$BACKUP_HDD_UUID" "$HOME/mount"; then :
else warn "backup HDD not found: /home data and docker volumes will be skipped"; fi
[ -n "${PASS_MIRROR_UUID:-}" ] && { mount_uuid "$PASS_MIRROR_UUID" /mnt/hd5 || true; }

# -- dotfiles: the HDD copy has the untracked local files too ------------------
if [ ! -d "$DOTFILES/.git" ]; then
  if [ -d "$HOME/mount/home-data/home/dotfiles/.git" ]; then
    log "dotfiles from the backup HDD"
    rsync -a "$HOME/mount/home-data/home/dotfiles/" "$DOTFILES/"
    git -C "$DOTFILES" pull --ff-only || warn "could not fast-forward dotfiles; using the backup copy"
  else
    log "dotfiles from GitHub"
    git clone --branch "$BRANCH" "$REPO" "$DOTFILES"
  fi
fi
git -C "$DOTFILES" submodule update --init --recursive || warn "submodules not initialised"

log "handing over to main.sh (RESTORE=1)"
cd "$DOTFILES"
RESTORE=1 bash ./main.sh
