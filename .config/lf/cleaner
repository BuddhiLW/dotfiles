#!/bin/sh
# lf cleaner. Runs when the preview pane changes — wipe any kitty image.
# Guarded: sending the clear escape to a non-kitty terminal just prints garbage.
if command -v kitten >/dev/null 2>&1 && { [ -n "$KITTY_WINDOW_ID" ] || case "$TERM" in *kitty*) true ;; *) false ;; esac; }; then
    kitten icat --clear --silent --stdin no --transfer-mode stream < /dev/null > /dev/tty
fi
exit 0
