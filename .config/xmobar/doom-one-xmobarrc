-- Xmobar (http://projects.haskell.org/xmobar/)
-- This is one of the xmobar configurations for DTOS.
-- This config is packaged in the DTOS repo as 'dtos-xmobar'
-- Color scheme: Doom One
-- Dependencies:
   -- otf-font-awesome
   -- ttf-mononoki
   -- ttf-ubuntu-font-family
   -- htop
   -- emacs
   -- pacman (Arch Linux)
   -- trayer
   -- 'dtos-local-bin' (from dtos-core-repo)

Config { font = "FiraCode Nerd Font 16"
        , additionalFonts = [
        "xft:FontAwesome:pixelsize=16:antialias=true:hinting=true"
        , "xft:Ubuntu:weight=bold:pixelsize=16:antialias=true:hinting=true"
        , "xft:Mononoki:pixelsize=16:antialias=true:hinting=true"
        ]
       , bgColor      = "#000000"
       , fgColor      = "#FA0A0A"
       -- Position TopSize and BottomSize take 3 arguments:
       --   an alignment parameter (L/R/C) for Left, Right or Center.
       --   an integer for the percentage width, so 100 would be 100%.
       --   an integer for the minimum pixel height for xmobar, so 24 would force a height of at least 24 pixels.
       --   NOTE: The height should be the same as the trayer (system tray) height.
       -- , position       = BottomSize C 95 70
       , position = Static { xpos = 2040 , ypos = 1020, width = 2280, height = 50 }
       -- , position     = BottomSize C 95 50
       -- , border       = FullB
       , borderColor =  "#FFFFFF"
       , lowerOnStart = True
       , hideOnStart  = False
       , allDesktops  = True
       , persistent   = True
       , iconRoot     = ".config/xmonad/xpm/"  -- default: "."
       , commands = [
                    Run Com ".local/bin/kernel" [] "kernel" 36000
                        -- Cpu usage in percent
                    , Run Cpu ["-t", "💻<total>%","-H","50","--high","red"] 20
                        -- Ram used number and percent
                    , Run Memory ["-t", "💾<usedratio>%"] 20
                        -- Disk space free
                    , Run DiskU [("/", "📁<free>")] [] 60
                        -- Echos an "up arrow" icon in front of the uptime output.
                    , Run Com "echo" ["🖥"] "uparrow" 3600
                        -- Uptime
                    , Run Uptime ["-t", "uptime: <days>d <hours>h"] 360
                        -- Echos a "bell" icon in front of the pacman updates.
                    , Run Com "echo" ["<fn=2>\xf0f3</fn>"] "bell" 3600
                        -- Check for pacman updates (script found in .local/bin)
                    , Run Com ".local/bin/pacupdate" [] "pacupdate" 36000
                    -- Battery
                    , Run Com ".local/bin/larbs/statusbar/sb-battery" [] "battery" 10
                    -- Pomodoro
                    , Run Com ".local/bin/blw/sb-pomo" [] "pomodoro" 1
                        -- Time and date
                    , Run Date "%d/%m/%Y %Hh%Mm" "date" 50
                        -- Script that dynamically adjusts xmobar padding depending on number of trayer icons.
                    , Run Com ".config/xmobar/trayer-padding-icon.sh" [] "trayerpad" 50
                        -- Prints out the left side items such as workspaces, layout, etc.
                    , Run UnsafeStdinReader
                    ]
       , sepChar = "%"
       , alignSep = "}{"
       , template = " λ <fc=#666666>|</fc> %UnsafeStdinReader%}{<box type=Bottom width=1 mb=1 mr=10 color=AAAAAA><fc=#EAEEFA>%battery%</fc></box> <box type=Right width=2 mb=1 mr=1 color=AAAAAA>  <fc=#EAEEFA>%pomodoro%</fc> </box>  <box type=Bottom width=1 mb=1 color=#ecbe7b><fc=#ecbe7b><action=`alacritty -e htop`>%cpu%</action></fc></box>  <box type=Bottom width=2 mb=1 color=#ff6c6b><fc=#ff6c6b><action=`alacritty -e htop`>%memory%</action></fc></box> <box type=Bottom width=2 mb=2 color=#a9a1e1><fc=#a9a1e1>%disku%</fc></box> <box type=Bottom width=2 mb=2 color=#46d9ff><fc=#46d9ff><action=`emacsclient -c -a 'emacs' --eval '(doom/window-maximize-buffer(dt/year-calendar))'`>%date%</action></fc></box>"
       }
